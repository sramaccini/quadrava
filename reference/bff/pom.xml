<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.logicwarez.quadrava.reference</groupId>
    <artifactId>quadrava-reference</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>quadrava-reference-bff</artifactId>
  <name>Quadrava reference - bff</name>
  <description>Backend For Frontend on authz-library: OIDC session with Keycloak in Redis, tokens on the server side only.</description>

  <properties>
    <authz-library.version>2.5.0</authz-library.version>
  </properties>

  <!-- authz-library is published on GitHub Packages, which asks for a token even for reading (DEVELOPMENT-GUIDE § 2). -->
  <repositories>
    <repository>
      <id>github-authz</id>
      <url>https://maven.pkg.github.com/sramaccini/authz-library</url>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </repository>
  </repositories>

  <dependencies>
    <!-- Login, session in Redis, /bff/* and /authz/* of the contracts, token relay, back-channel logout. -->
    <dependency>
      <groupId>com.logicwarez.authz</groupId>
      <artifactId>authz-bff</artifactId>
      <version>${authz-library.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
