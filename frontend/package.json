{
  "name": "lowcode",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run start:runtime",
    "start:runtime": "npm run demo:prepare && ng serve runtime --port 4200",
    "start:editor": "ng serve editor --port 4201",
    "build": "ng build",
    "test": "ng test",
    "validate:examples": "node tools/validate-examples.mjs",
    "schema:sync": "node tools/sync-schema.mjs",
    "schema:check": "node tools/sync-schema.mjs --check",
    "build:libs": "ng build schema && ng build expressions && ng build core && ng build components && ng build services",
    "demo:prepare": "npm run build:libs && node tools/copy-examples.mjs",
    "test:libs": "ng test schema --watch=false && ng test expressions --watch=false && ng test core --watch=false && ng test components --watch=false && ng test services --watch=false"
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/cdk": "^22.2.2",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@ant-design/colors": "^7.2.1",
    "@ant-design/icons-angular": "^22.1.1",
    "@marcbachmann/cel-js": "^8.0.0",
    "date-fns": "^4.4.0",
    "ng-zorro-antd": "^22.1.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.0",
    "ajv": "^8.20.0",
    "jsdom": "^30.0.0",
    "ng-packagr": "^22.2.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
