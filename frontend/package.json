{
  "name": "quadrava",
  "version": "0.34.0",
  "license": "MPL-2.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run start:runtime",
    "start:runtime": "npm run demo:prepare && ng serve runtime --port 4200",
    "build": "ng build",
    "test": "ng test",
    "validate:examples": "npm run cli:build && node dist/cli/bin/quadrava.mjs validate ../examples",
    "schema:sync": "node tools/sync-schema.mjs",
    "schema:check": "node tools/sync-schema.mjs --check",
    "build:libs": "ng build schema && ng build expressions && ng build core && ng build components && ng build services",
    "demo:prepare": "npm run build:libs && node tools/copy-examples.mjs",
    "deploy:config": "node tools/deploy-config.mjs",
    "test:libs": "ng test schema --watch=false && ng test expressions --watch=false && ng test core --watch=false && ng test components --watch=false && ng test services --watch=false",
    "e2e": "playwright test",
    "start:runtime:registry": "npm run demo:prepare && ng serve runtime --port 4200 -c registry",
    "start:runtime:bff": "npm run demo:prepare && ng serve runtime --port 4200 -c bff",
    "publish:examples": "node tools/publish-examples.mjs",
    "demo-api": "node tools/demo-api.mjs",
    "stack": "node tools/stack.mjs",
    "schema:docs": "node tools/schema-docs.mjs",
    "schema:docs:check": "node tools/schema-docs.mjs --check",
    "notices": "node tools/third-party-notices.mjs",
    "notices:check": "node tools/third-party-notices.mjs --check",
    "nz:dark": "node tools/nz-dark-theme.mjs",
    "nz:dark:check": "node tools/nz-dark-theme.mjs --check",
    "icons": "node tools/ant-icons.mjs",
    "icons:check": "node tools/ant-icons.mjs --check",
    "conformance": "node tools/conformance.mjs",
    "conformance:registry": "node tools/conformance-registry.mjs",
    "conformance:authz": "node tools/conformance-authz.mjs",
    "conformance:telemetry": "node tools/conformance-telemetry.mjs",
    "conformance:bff": "node tools/conformance-bff.mjs",
    "release:check": "node tools/release.mjs",
    "lint": "eslint .",
    "deps:check": "depcruise projects --config .dependency-cruiser.cjs --output-type err",
    "cli:build": "node projects/cli/build.mjs",
    "cli:typecheck": "tsc -p projects/cli/tsconfig.json",
    "cli:test": "npm run cli:typecheck && npm run cli:build && node --test \"projects/cli/src/*.spec.mjs\""
  },
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/cdk": "^22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@ant-design/colors": "^8.0.1",
    "@ant-design/icons-angular": "^22.1.1",
    "@fontsource/sora": "^5.3.0",
    "@marcbachmann/cel-js": "^8.0.0",
    "date-fns": "^4.4.0",
    "ng-zorro-antd": "^22.2.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "~10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "~24.19.4",
    "ajv": "^8.20.0",
    "angular-eslint": "~22.8.0",
    "dependency-cruiser": "~18.9.0",
    "esbuild": "^0.28.2",
    "eslint": "~10.15.0",
    "fflate": "0.8.3",
    "jsdom": "^31.0.1",
    "ng-packagr": "^22.3.0",
    "prettier": "^3.10.1",
    "svgo": "4.1.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "~8.74.0",
    "vitest": "^5.0.0"
  }
}
