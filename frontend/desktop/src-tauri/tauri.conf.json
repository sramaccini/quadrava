{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quadrava Studio",
  "version": "0.1.0",
  "identifier": "dev.quadrava.studio",
  "build": {
    "frontendDist": "../../dist/editor/browser",
    "devUrl": "http://localhost:4301"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Quadrava Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https: http:; frame-src 'self'; object-src 'none'; base-uri 'self'",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Visual editor of Quadrava",
    "longDescription": "Quadrava Studio edits the screens, data sources, navigation, themes and translations of a Quadrava application, with live previews.",
    "license": "MPL-2.0",
    "copyright": "Copyright 2026 Simone Ramaccini",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
