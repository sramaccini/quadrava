{
  "openapi": "3.0.1",
  "info": { "title": "Quadrava demo API", "version": "1.0", "description": "The APIs of the sample back end of the demo (tools/demo-api.mjs), described as springdoc would publish them in Spring Boot." },
  "servers": [{ "url": "http://localhost:8084", "description": "Generated server url" }],
  "tags": [
    { "name": "orders", "description": "Customer orders" },
    { "name": "invoices", "description": "Sales and purchase invoices" },
    { "name": "registry", "description": "Customers and contacts" },
    { "name": "expenses", "description": "Expense claims to review" },
    { "name": "medical-staff", "description": "Staff of the hospital (samples/medical-staff)" }
  ],
  "paths": {
    "/api/orders": {
      "get": {
        "tags": ["orders"],
        "summary": "List of orders, in pages",
        "operationId": "listOrders",
        "parameters": [
          { "name": "status", "in": "query", "required": false, "schema": { "type": "string", "enum": ["draft", "submitted", "approved"] } },
          { "name": "page", "in": "query", "required": false, "schema": { "type": "integer", "format": "int32", "default": 0 } },
          { "name": "sort", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "OK", "content": { "*/*": { "schema": { "$ref": "#/components/schemas/OrderPage" } } } } }
      }
    },
    "/api/orders/{id}": {
      "get": {
        "tags": ["orders"],
        "summary": "Detail of an order",
        "operationId": "getOrder",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } }],
        "responses": { "200": { "description": "OK", "content": { "*/*": { "schema": { "$ref": "#/components/schemas/Order" } } } }, "404": { "description": "Not found" } }
      },
      "put": {
        "tags": ["orders"],
        "summary": "Changes customer, type and discount of an order",
        "operationId": "updateOrder",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } }],
        "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/OrderUpdate" } } }, "required": true },
        "responses": { "200": { "description": "OK", "content": { "*/*": { "schema": { "$ref": "#/components/schemas/Order" } } } } }
      }
    },
    "/api/orders/{id}/approve": {
      "post": {
        "tags": ["orders"],
        "summary": "Approves a submitted order",
        "operationId": "approveOrder",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } }],
        "responses": { "200": { "description": "OK" }, "409": { "description": "The order is not submitted" } }
      }
    },
    "/api/invoices": {
      "get": {
        "tags": ["invoices"],
        "summary": "List of invoices, in pages and with filters",
        "operationId": "listInvoices",
        "parameters": [
          { "name": "status", "in": "query", "required": false, "schema": { "type": "array", "items": { "type": "string", "enum": ["draft", "sent", "paid"] } } },
          { "name": "type", "in": "query", "required": false, "schema": { "type": "string", "enum": ["sales", "purchase"] } },
          { "name": "customer", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "page", "in": "query", "required": false, "schema": { "type": "integer", "format": "int32", "default": 0 } }
        ],
        "responses": { "200": { "description": "OK", "content": { "*/*": { "schema": { "$ref": "#/components/schemas/InvoicePage" } } } } }
      },
      "post": {
        "tags": ["invoices"],
        "summary": "Creates a draft invoice",
        "operationId": "createInvoice",
        "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NewInvoice" } } }, "required": true },
        "responses": { "200": { "description": "OK", "content": { "*/*": { "schema": { "$ref": "#/components/schemas/Created" } } } } }
      }
    },
    "/api/invoices/{id}/send": {
      "post": {
        "tags": ["invoices"],
        "summary": "Sends a draft invoice",
        "operationId": "sendInvoice",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } }],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/deadlines": {
      "get": {
        "tags": ["invoices"],
        "summary": "Deadlines of a month",
        "operationId": "listDeadlines",
        "parameters": [{ "name": "month", "in": "query", "required": true, "description": "YYYY-MM", "schema": { "type": "string", "pattern": "^\\d{4}-\\d{2}$", "example": "2026-10" } }],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Deadline" } },
                "example": [
                  { "id": 1, "date": "2026-10-03", "title": "Office rent", "status": "paid", "amount": 150 },
                  { "id": 2, "date": "2026-10-08", "title": "Social security payment", "status": "to-pay", "amount": 370 }
                ]
              }
            }
          }
        }
      }
    },
    "/api/customers": {
      "get": {
        "tags": ["registry"],
        "summary": "Customers, searched by name",
        "operationId": "listCustomers",
        "parameters": [{ "name": "q", "in": "query", "required": false, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "OK", "content": { "*/*": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Customer" } } } } } }
      }
    },
    "/api/contacts": {
      "get": {
        "tags": ["registry"],
        "summary": "Contacts",
        "operationId": "listContacts",
        "responses": { "200": { "description": "OK", "content": { "*/*": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Contact" } } } } } }
      },
      "post": {
        "tags": ["registry"],
        "summary": "New contact",
        "operationId": "createContact",
        "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Contact" } } }, "required": true },
        "responses": { "200": { "description": "OK", "content": { "*/*": { "schema": { "$ref": "#/components/schemas/Created" } } } } }
      }
    },
    "/api/expenses": {
      "get": {
        "tags": ["expenses"],
        "summary": "Expense claims",
        "operationId": "listExpenses",
        "responses": { "200": { "description": "OK", "content": { "*/*": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Expense" } } } } } }
      }
    },
    "/api/medical-staff": {
      "get": {
        "tags": ["medical-staff"],
        "summary": "Staff of the hospital: one page with page, all the rows without it (CSV export)",
        "operationId": "listStaff",
        "parameters": [
          { "name": "q", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "staffType", "in": "query", "required": false, "schema": { "type": "string", "enum": ["doctor", "nurse", "midwife", "technician", "therapist", "pharmacist", "assistant"] } },
          { "name": "department", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "active", "in": "query", "required": false, "schema": { "type": "string", "enum": ["true", "false"] } },
          { "name": "page", "in": "query", "required": false, "schema": { "type": "integer", "format": "int32" } }
        ],
        "responses": { "200": { "description": "OK", "content": { "*/*": { "schema": { "$ref": "#/components/schemas/StaffPage" } } } } }
      },
      "post": {
        "tags": ["medical-staff"],
        "summary": "Adds a staff member",
        "operationId": "createStaff",
        "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/StaffMember" } } }, "required": true },
        "responses": { "200": { "description": "OK", "content": { "*/*": { "schema": { "$ref": "#/components/schemas/StaffMember" } } } }, "400": { "description": "Required fields missing" }, "409": { "description": "Staff number already used" } }
      }
    },
    "/api/medical-staff/{id}": {
      "get": {
        "tags": ["medical-staff"],
        "summary": "A staff member",
        "operationId": "getStaff",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } }],
        "responses": { "200": { "description": "OK", "content": { "*/*": { "schema": { "$ref": "#/components/schemas/StaffMember" } } } }, "404": { "description": "Not found" } }
      },
      "put": {
        "tags": ["medical-staff"],
        "summary": "Saves a staff member (the staff number does not change)",
        "operationId": "updateStaff",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } }],
        "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/StaffMember" } } }, "required": true },
        "responses": { "200": { "description": "OK", "content": { "*/*": { "schema": { "$ref": "#/components/schemas/StaffMember" } } } }, "404": { "description": "Not found" } }
      },
      "delete": {
        "tags": ["medical-staff"],
        "summary": "Removes a staff member",
        "operationId": "removeStaff",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } }],
        "responses": { "200": { "description": "OK" }, "404": { "description": "Not found" } }
      }
    }
  },
  "components": {
    "schemas": {
      "Order": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64", "example": 1001 },
          "number": { "type": "string", "example": "ORD-2026-001" },
          "customer": { "type": "string", "example": "Smith Ltd" },
          "type": { "type": "string", "enum": ["private", "business"] },
          "status": { "type": "string", "enum": ["draft", "submitted", "approved"] },
          "amount": { "type": "number", "format": "double", "example": 1250.5 },
          "date": { "type": "string", "format": "date" },
          "discount": { "type": "number", "format": "double" }
        }
      },
      "OrderUpdate": {
        "type": "object",
        "properties": { "customer": { "type": "string" }, "type": { "type": "string", "enum": ["private", "business"] }, "discount": { "type": "number" } }
      },
      "OrderPage": {
        "type": "object",
        "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/Order" } }, "total": { "type": "integer", "example": 42 }, "size": { "type": "integer", "example": 10 } }
      },
      "Invoice": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "number": { "type": "string", "example": "FT-2026-001" },
          "customer": { "type": "string", "example": "Baker Inc" },
          "type": { "type": "string", "enum": ["sales", "purchase"] },
          "amount": { "type": "number", "format": "double", "example": 980 },
          "status": { "type": "string", "enum": ["draft", "sent", "paid"] },
          "issued": { "type": "string", "format": "date" },
          "collected": { "type": "boolean" }
        }
      },
      "NewInvoice": {
        "type": "object",
        "required": ["number", "customer"],
        "properties": { "number": { "type": "string" }, "customer": { "type": "string" }, "type": { "type": "string", "enum": ["sales", "purchase"] }, "amount": { "type": "number" } }
      },
      "InvoicePage": {
        "type": "object",
        "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/Invoice" } }, "total": { "type": "integer", "example": 24 }, "size": { "type": "integer", "example": 10 } }
      },
      "Deadline": {
        "type": "object",
        "properties": { "id": { "type": "integer" }, "date": { "type": "string", "format": "date" }, "title": { "type": "string" }, "status": { "type": "string", "enum": ["paid", "to-pay", "overdue"] }, "amount": { "type": "number" } }
      },
      "Customer": { "type": "object", "properties": { "id": { "type": "string", "example": "C001" }, "name": { "type": "string", "example": "Smith Ltd" } } },
      "Contact": {
        "type": "object",
        "properties": { "id": { "type": "integer" }, "name": { "type": "string" }, "email": { "type": "string", "format": "email" }, "phone": { "type": "string" } }
      },
      "Expense": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "description": { "type": "string", "example": "Train Milan-Rome" },
          "employee": { "type": "string", "example": "M. Conti" },
          "amount": { "type": "number", "example": 39 },
          "status": { "type": "string", "enum": ["to-review", "accepted", "rejected"] }
        }
      },
      "Created": { "type": "object", "properties": { "id": { "type": "integer", "format": "int64", "example": 1025 } } },
      "StaffMember": {
        "type": "object",
        "required": ["registrationNumber", "staffType", "firstName", "lastName", "department", "contract", "hireDate"],
        "properties": {
          "id": { "type": "integer", "format": "int64", "example": 1 },
          "registrationNumber": { "type": "string", "example": "HS001001" },
          "staffType": { "type": "string", "enum": ["doctor", "nurse", "midwife", "technician", "therapist", "pharmacist", "assistant"] },
          "firstName": { "type": "string", "example": "Anna" },
          "lastName": { "type": "string", "example": "Rossi" },
          "specialty": { "type": "string", "example": "Cardiology" },
          "licenseNumber": { "type": "string", "example": "REG-52000" },
          "department": { "type": "string", "enum": ["emergency", "cardiology", "surgery", "pediatrics", "radiology", "internal-medicine", "obstetrics", "pharmacy"] },
          "contract": { "type": "string", "enum": ["permanent", "fixed-term", "consultant"] },
          "hireDate": { "type": "string", "format": "date" },
          "contractEnd": { "type": "string", "format": "date" },
          "shift": { "type": "string", "enum": ["day", "rotating", "night", "on-call"] },
          "weeklyHours": { "type": "integer", "example": 36 },
          "email": { "type": "string", "format": "email" },
          "phone": { "type": "string", "example": "+39 02 5550 100" },
          "active": { "type": "boolean" },
          "notes": { "type": "string" }
        }
      },
      "StaffPage": { "type": "object", "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/StaffMember" } }, "total": { "type": "integer", "example": 26 }, "size": { "type": "integer", "example": 8 } } }
    }
  }
}
