{
  "openapi": "3.0.1",
  "info": { "title": "Quadrava demo API", "version": "1.0", "description": "Le API del backend di esempio della demo (tools/demo-api.mjs), descritte come le pubblicherebbe springdoc in Spring Boot." },
  "servers": [{ "url": "http://localhost:8084", "description": "Generated server url" }],
  "tags": [
    { "name": "ordini", "description": "Ordini dei clienti" },
    { "name": "fatture", "description": "Fatture attive e passive" },
    { "name": "anagrafiche", "description": "Clienti e contatti" },
    { "name": "spese", "description": "Note spese da revisionare" }
  ],
  "paths": {
    "/api/ordini": {
      "get": {
        "tags": ["ordini"],
        "summary": "Elenco degli ordini, a pagine",
        "operationId": "listOrdini",
        "parameters": [
          { "name": "stato", "in": "query", "required": false, "schema": { "type": "string", "enum": ["bozza", "inviato", "approvato"] } },
          { "name": "page", "in": "query", "required": false, "schema": { "type": "integer", "format": "int32", "default": 0 } },
          { "name": "sort", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "OK", "content": { "*/*": { "schema": { "$ref": "#/components/schemas/PaginaOrdini" } } } } }
      }
    },
    "/api/ordini/{id}": {
      "get": {
        "tags": ["ordini"],
        "summary": "Dettaglio di un ordine",
        "operationId": "getOrdine",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } }],
        "responses": { "200": { "description": "OK", "content": { "*/*": { "schema": { "$ref": "#/components/schemas/Ordine" } } } }, "404": { "description": "Non trovato" } }
      },
      "put": {
        "tags": ["ordini"],
        "summary": "Modifica cliente, tipo e sconto di un ordine",
        "operationId": "updateOrdine",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } }],
        "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ModificaOrdine" } } }, "required": true },
        "responses": { "200": { "description": "OK", "content": { "*/*": { "schema": { "$ref": "#/components/schemas/Ordine" } } } } }
      }
    },
    "/api/ordini/{id}/approva": {
      "post": {
        "tags": ["ordini"],
        "summary": "Approva un ordine inviato",
        "operationId": "approvaOrdine",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } }],
        "responses": { "200": { "description": "OK" }, "409": { "description": "L'ordine non è in stato inviato" } }
      }
    },
    "/api/fatture": {
      "get": {
        "tags": ["fatture"],
        "summary": "Elenco delle fatture, a pagine e con filtri",
        "operationId": "listFatture",
        "parameters": [
          { "name": "stato", "in": "query", "required": false, "schema": { "type": "array", "items": { "type": "string", "enum": ["bozza", "inviata", "pagata"] } } },
          { "name": "tipo", "in": "query", "required": false, "schema": { "type": "string", "enum": ["attiva", "passiva"] } },
          { "name": "cliente", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "page", "in": "query", "required": false, "schema": { "type": "integer", "format": "int32", "default": 0 } }
        ],
        "responses": { "200": { "description": "OK", "content": { "*/*": { "schema": { "$ref": "#/components/schemas/PaginaFatture" } } } } }
      },
      "post": {
        "tags": ["fatture"],
        "summary": "Crea una fattura in bozza",
        "operationId": "createFattura",
        "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/NuovaFattura" } } }, "required": true },
        "responses": { "200": { "description": "OK", "content": { "*/*": { "schema": { "$ref": "#/components/schemas/Creato" } } } } }
      }
    },
    "/api/fatture/{id}/invia": {
      "post": {
        "tags": ["fatture"],
        "summary": "Invia una fattura in bozza",
        "operationId": "inviaFattura",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } }],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/api/scadenze": {
      "get": {
        "tags": ["fatture"],
        "summary": "Scadenze di un mese",
        "operationId": "listScadenze",
        "parameters": [{ "name": "mese", "in": "query", "required": true, "description": "AAAA-MM", "schema": { "type": "string", "pattern": "^\\d{4}-\\d{2}$", "example": "2026-10" } }],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Scadenza" } },
                "example": [
                  { "id": 1, "data": "2026-10-03", "titolo": "Affitto ufficio", "stato": "pagata", "importo": 150 },
                  { "id": 2, "data": "2026-10-08", "titolo": "F24 contributi", "stato": "da-pagare", "importo": 370 }
                ]
              }
            }
          }
        }
      }
    },
    "/api/clienti": {
      "get": {
        "tags": ["anagrafiche"],
        "summary": "Clienti, con ricerca per nome",
        "operationId": "listClienti",
        "parameters": [{ "name": "q", "in": "query", "required": false, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "OK", "content": { "*/*": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Cliente" } } } } } }
      }
    },
    "/api/contatti": {
      "get": {
        "tags": ["anagrafiche"],
        "summary": "Contatti",
        "operationId": "listContatti",
        "responses": { "200": { "description": "OK", "content": { "*/*": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Contatto" } } } } } }
      },
      "post": {
        "tags": ["anagrafiche"],
        "summary": "Nuovo contatto",
        "operationId": "createContatto",
        "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Contatto" } } }, "required": true },
        "responses": { "200": { "description": "OK", "content": { "*/*": { "schema": { "$ref": "#/components/schemas/Creato" } } } } }
      }
    },
    "/api/spese": {
      "get": {
        "tags": ["spese"],
        "summary": "Note spese",
        "operationId": "listSpese",
        "responses": { "200": { "description": "OK", "content": { "*/*": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Spesa" } } } } } }
      }
    }
  },
  "components": {
    "schemas": {
      "Ordine": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64", "example": 1001 },
          "numero": { "type": "string", "example": "ORD-2026-001" },
          "cliente": { "type": "string", "example": "Rossi Srl" },
          "tipo": { "type": "string", "enum": ["standard", "urgente"] },
          "stato": { "type": "string", "enum": ["bozza", "inviato", "approvato"] },
          "importo": { "type": "number", "format": "double", "example": 1250.5 },
          "data": { "type": "string", "format": "date" },
          "sconto": { "type": "number", "format": "double" }
        }
      },
      "ModificaOrdine": {
        "type": "object",
        "properties": { "cliente": { "type": "string" }, "tipo": { "type": "string", "enum": ["standard", "urgente"] }, "sconto": { "type": "number" } }
      },
      "PaginaOrdini": {
        "type": "object",
        "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/Ordine" } }, "total": { "type": "integer", "example": 42 }, "size": { "type": "integer", "example": 10 } }
      },
      "Fattura": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "numero": { "type": "string", "example": "FT-2026-001" },
          "cliente": { "type": "string", "example": "Bianchi SpA" },
          "tipo": { "type": "string", "enum": ["attiva", "passiva"] },
          "importo": { "type": "number", "format": "double", "example": 980 },
          "stato": { "type": "string", "enum": ["bozza", "inviata", "pagata"] },
          "emessa": { "type": "string", "format": "date" },
          "incassata": { "type": "boolean" }
        }
      },
      "NuovaFattura": {
        "type": "object",
        "required": ["numero", "cliente"],
        "properties": { "numero": { "type": "string" }, "cliente": { "type": "string" }, "tipo": { "type": "string", "enum": ["attiva", "passiva"] }, "importo": { "type": "number" } }
      },
      "PaginaFatture": {
        "type": "object",
        "properties": { "items": { "type": "array", "items": { "$ref": "#/components/schemas/Fattura" } }, "total": { "type": "integer", "example": 24 }, "size": { "type": "integer", "example": 10 } }
      },
      "Scadenza": {
        "type": "object",
        "properties": { "id": { "type": "integer" }, "data": { "type": "string", "format": "date" }, "titolo": { "type": "string" }, "stato": { "type": "string", "enum": ["pagata", "da-pagare", "scaduta"] }, "importo": { "type": "number" } }
      },
      "Cliente": { "type": "object", "properties": { "id": { "type": "string", "example": "C001" }, "nome": { "type": "string", "example": "Rossi Srl" } } },
      "Contatto": {
        "type": "object",
        "properties": { "id": { "type": "integer" }, "nome": { "type": "string" }, "email": { "type": "string", "format": "email" }, "telefono": { "type": "string" } }
      },
      "Spesa": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "descrizione": { "type": "string", "example": "Treno Milano-Roma" },
          "dipendente": { "type": "string", "example": "M. Conti" },
          "importo": { "type": "number", "example": 39 },
          "stato": { "type": "string", "enum": ["da-revisionare", "approvata", "respinta"] }
        }
      },
      "Creato": { "type": "object", "properties": { "id": { "type": "integer", "format": "int64", "example": 1025 } } }
    }
  }
}
