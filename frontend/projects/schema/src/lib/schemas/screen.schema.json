{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lowcode.example/schemas/screen.schema.json",
  "title": "Schermata",
  "description": "Nucleo del linguaggio di definizione: una schermata di un'applicazione LowCode con il catalogo dei componenti di base.",
  "type": "object",
  "required": [
    "schemaVersion",
    "screen",
    "components"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "screen": {
      "$ref": "#/$defs/id",
      "description": "Identificativo stabile della schermata."
    },
    "title": {
      "type": "string"
    },
    "requires": {
      "$ref": "#/$defs/permission",
      "description": "Permesso necessario per aprire la schermata."
    },
    "dataSources": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/dataSource"
      }
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "description": {
      "type": "string",
      "maxLength": 300,
      "description": "Frase mostrata sotto il titolo, nell'intestazione di pagina."
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Identificativo in kebab-case. Una volta pubblicato non cambia."
    },
    "permission": {
      "type": "string",
      "pattern": "^[a-z0-9]+\\.[a-z0-9]+\\.[a-z0-9]+$",
      "description": "Permesso nel formato dominio.risorsa.azione (tre parti, per esempio ordini.ordine.approva)."
    },
    "expression": {
      "type": "string",
      "pattern": "^\\{\\{[\\s\\S]+\\}\\}$",
      "description": "Espressione CEL tra doppie graffe, per esempio {{can('ordini.ordine.approva') && row.stato == 'inviato'}}. Variabili disponibili: user, state, params, row, form, value. Funzione disponibile: can(permesso)."
    },
    "dataSource": {
      "type": "object",
      "required": [
        "type",
        "method",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "rest"
        },
        "method": {
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ]
        },
        "url": {
          "type": "string"
        },
        "params": {
          "type": "object",
          "description": "Parametri di query (GET, DELETE)."
        },
        "body": {
          "description": "Corpo della richiesta (POST, PUT, PATCH): un oggetto con espressioni oppure una sola espressione, per esempio {{form}}. Se manca si usa params.",
          "oneOf": [
            {
              "type": "object"
            },
            {
              "$ref": "#/$defs/expression"
            }
          ]
        },
        "paging": {
          "enum": [
            "server",
            "none"
          ]
        }
      }
    },
    "step": {
      "oneOf": [
        {
          "$ref": "#/$defs/stepCall"
        },
        {
          "$ref": "#/$defs/stepRefresh"
        },
        {
          "$ref": "#/$defs/stepNavigate"
        },
        {
          "$ref": "#/$defs/stepToast"
        },
        {
          "$ref": "#/$defs/stepSet"
        },
        {
          "$ref": "#/$defs/stepConfirm"
        },
        {
          "$ref": "#/$defs/stepDialog"
        }
      ]
    },
    "steps": {
      "oneOf": [
        {
          "$ref": "#/$defs/step"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      ]
    },
    "stepCall": {
      "type": "object",
      "required": [
        "call"
      ],
      "additionalProperties": false,
      "properties": {
        "call": {
          "type": "string",
          "description": "Nome del data source da eseguire."
        },
        "args": {
          "type": "object"
        },
        "onError": {
          "$ref": "#/$defs/steps"
        }
      }
    },
    "stepRefresh": {
      "type": "object",
      "required": [
        "refresh"
      ],
      "additionalProperties": false,
      "properties": {
        "refresh": {
          "type": "string",
          "description": "Nome del data source da ricaricare."
        }
      }
    },
    "stepNavigate": {
      "type": "object",
      "required": [
        "navigate"
      ],
      "additionalProperties": false,
      "properties": {
        "navigate": {
          "$ref": "#/$defs/id"
        },
        "params": {
          "type": "object"
        }
      }
    },
    "stepToast": {
      "type": "object",
      "required": [
        "toast"
      ],
      "additionalProperties": false,
      "properties": {
        "toast": {
          "type": "string"
        }
      }
    },
    "stepSet": {
      "type": "object",
      "required": [
        "set"
      ],
      "additionalProperties": false,
      "properties": {
        "set": {
          "type": "object",
          "required": [
            "path",
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string"
            },
            "value": {}
          }
        }
      }
    },
    "action": {
      "type": "object",
      "required": [
        "label",
        "onClick"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string"
        },
        "visibleIf": {
          "$ref": "#/$defs/expression"
        },
        "hiddenIf": {
          "$ref": "#/$defs/expression"
        },
        "enabledIf": {
          "$ref": "#/$defs/expression"
        },
        "onClick": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "tooltip": {
          "type": "string",
          "description": "Testo di aiuto mostrato al passaggio del mouse o con il focus. Solo testo (mai HTML); può contenere {{ }}."
        }
      }
    },
    "field": {
      "type": "object",
      "required": [
        "name",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z][A-Za-z0-9]*$"
        },
        "type": {
          "enum": [
            "text",
            "number",
            "select",
            "checkbox",
            "date",
            "textarea",
            "datetime",
            "radio",
            "switch",
            "multiselect",
            "lookup",
            "file",
            "repeater"
          ],
          "description": "Tipo di campo. textarea: testo su più righe (`rows`); datetime: data e ora AAAA-MM-GGTHH:mm (ora locale); radio: scelta tra `options`; switch: interruttore vero/falso; multiselect: elenco di valori di `options`. lookup: valore scelto tra le righe di un data source cercate mentre si scrive (`lookup`). file: un file scelto dall’utente (`accept`, `maxSizeKb`, `upload`). repeater: elenco di righe, ognuna con i campi di `fields` (`minRows`, `maxRows`, `addLabel`)."
        },
        "label": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sensitive": {
          "type": "boolean",
          "description": "Il valore non compare mai in tracce e log."
        },
        "visibleIf": {
          "$ref": "#/$defs/expression"
        },
        "hiddenIf": {
          "$ref": "#/$defs/expression"
        },
        "readOnlyIf": {
          "$ref": "#/$defs/expression"
        },
        "validate": {
          "type": "object",
          "required": [
            "rule",
            "message"
          ],
          "additionalProperties": false,
          "properties": {
            "rule": {
              "$ref": "#/$defs/expression"
            },
            "message": {
              "type": "string"
            }
          }
        },
        "tooltip": {
          "type": "string",
          "description": "Testo di aiuto mostrato al passaggio del mouse o con il focus. Solo testo (mai HTML); può contenere {{ }}."
        },
        "optionKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$",
          "minLength": 1,
          "maxLength": 100,
          "description": "Prefisso delle chiavi di traduzione per le etichette delle opzioni: l'etichetta di un'opzione è t('<prefisso>.<valore>'), con il valore come ripiego."
        },
        "rows": {
          "type": "integer",
          "minimum": 2,
          "maximum": 20,
          "description": "Righe visibili di un campo textarea (4 se assente)."
        },
        "lookup": {
          "type": "object",
          "required": [
            "source",
            "labelField"
          ],
          "additionalProperties": false,
          "description": "Per type lookup: data source GET da interrogare con la variabile `search` (per esempio \"params\": { \"q\": \"{{ search }}\" }).",
          "properties": {
            "source": {
              "type": "string",
              "description": "Nome del data source (GET) che restituisce le righe proposte."
            },
            "valueField": {
              "type": "string",
              "description": "Campo della riga che diventa il valore (id se assente)."
            },
            "labelField": {
              "type": "string",
              "description": "Campo della riga mostrato come testo."
            },
            "minChars": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5,
              "description": "Caratteri minimi prima di cercare (1 se assente; 0 = cerca anche a campo vuoto)."
            }
          }
        },
        "accept": {
          "type": "string",
          "pattern": "^\\s*(\\.[A-Za-z0-9]+|[a-z]+/(\\*|[A-Za-z0-9.+-]+))(\\s*,\\s*(\\.[A-Za-z0-9]+|[a-z]+/(\\*|[A-Za-z0-9.+-]+)))*\\s*$",
          "description": "Per type file: estensioni (.pdf) e tipi MIME (image/*, application/pdf) ammessi, separati da virgole."
        },
        "maxSizeKb": {
          "type": "integer",
          "minimum": 1,
          "maximum": 102400,
          "description": "Per type file: dimensione massima in KB (1024 se assente). Fino a 102400 con invio multipart; il contenuto in base64 è limitato a 10240."
        },
        "upload": {
          "type": "string",
          "description": "Per type file: data source (POST) a cui inviare subito il file. In multipart il file è la parte \"file\" della richiesta e la variabile `file` ha name, type e size; in base64 ha anche content."
        },
        "span": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4,
          "description": "Colonne occupate dal campo nella griglia del form (1 se assente)."
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "description": "Per type repeater: i campi di ogni riga (text, number, select, checkbox, date, textarea, switch, lookup, file; niente righe annidate). Le regole di validazione vedono la riga in `item`.",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/field"
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "enum": [
                      "text",
                      "number",
                      "select",
                      "checkbox",
                      "date",
                      "textarea",
                      "switch",
                      "lookup",
                      "file"
                    ]
                  }
                }
              }
            ]
          }
        },
        "minRows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50,
          "description": "Per type repeater: righe minime (0 se assente)."
        },
        "maxRows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "description": "Per type repeater: righe massime (50 se assente)."
        },
        "addLabel": {
          "type": "string",
          "description": "Per type repeater: testo del pulsante che aggiunge una riga."
        },
        "uploadAs": {
          "enum": [
            "multipart",
            "base64"
          ],
          "description": "Per type file con upload: multipart (il file viaggia come file, variabile `file` con name, type e size; predefinito) oppure base64 (il contenuto in `file.content` dentro il corpo JSON)."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "lookup"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "lookup"
            ],
            "properties": {
              "lookup": true
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "repeater"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "fields"
            ],
            "properties": {
              "fields": true
            }
          }
        }
      ]
    },
    "column": {
      "type": "object",
      "$ref": "#/$defs/columnProps",
      "unevaluatedProperties": false
    },
    "node": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": [
            "section",
            "text",
            "button",
            "filterBar",
            "table",
            "form",
            "tabs",
            "detail",
            "alert",
            "stats",
            "wizard",
            "tree",
            "calendar",
            "chart",
            "dataTable"
          ]
        },
        "visibleIf": {
          "$ref": "#/$defs/expression"
        },
        "hiddenIf": {
          "$ref": "#/$defs/expression"
        },
        "enabledIf": {
          "$ref": "#/$defs/expression"
        },
        "readOnlyIf": {
          "$ref": "#/$defs/expression"
        },
        "tooltip": {
          "type": "string",
          "description": "Testo di aiuto mostrato al passaggio del mouse o con il focus. Solo testo (mai HTML); può contenere {{ }}."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "section"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "type": "object",
            "required": [
              "components"
            ],
            "properties": {
              "title": {
                "type": "string"
              },
              "components": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/node"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "text"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "type": "object",
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "style": {
                "enum": [
                  "heading",
                  "body"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "button"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "type": "object",
            "required": [
              "label",
              "onClick"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "onClick": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/step"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "filterBar"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "type": "object",
            "required": [
              "bind",
              "fields"
            ],
            "properties": {
              "bind": {
                "type": "string",
                "description": "Percorso nello stato della schermata, per esempio state.filtri."
              },
              "fields": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/field"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "table"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "type": "object",
            "required": [
              "source",
              "columns"
            ],
            "properties": {
              "source": {
                "type": "string",
                "description": "Nome del data source che fornisce le righe."
              },
              "columns": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/tableColumn"
                }
              },
              "rowActions": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/action"
                }
              },
              "sort": {
                "type": "object",
                "additionalProperties": false,
                "description": "Ordinamento. Con paging server lo fa il servizio: la tabella scrive { field, direction } nello stato `bind`; altrimenti ordina in pagina le righe caricate.",
                "properties": {
                  "bind": {
                    "$ref": "#/$defs/statePath"
                  },
                  "default": {
                    "$ref": "#/$defs/sortSpec",
                    "description": "Ordinamento all'apertura della schermata."
                  }
                }
              },
              "selection": {
                "type": "object",
                "required": [
                  "bind"
                ],
                "additionalProperties": false,
                "description": "Selezione delle righe: le chiavi delle righe scelte stanno nello stato `bind`; le azioni multiple vedono le righe intere in `selection`.",
                "properties": {
                  "bind": {
                    "$ref": "#/$defs/statePath"
                  },
                  "key": {
                    "type": "string",
                    "description": "Campo che identifica la riga (id se assente)."
                  }
                }
              },
              "bulkActions": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/action"
                },
                "description": "Azioni sulle righe selezionate, sopra la tabella. Le espressioni vedono `selection` (elenco delle righe scelte)."
              },
              "rowActionsInline": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10,
                "description": "Quante azioni di riga (visibili) mostrare come pulsanti; le altre finiscono nel menu «⋯». 0 = tutte nel menu; se manca, tutte pulsanti."
              },
              "expand": {
                "type": "object",
                "required": [
                  "components"
                ],
                "additionalProperties": false,
                "description": "Area che si apre sotto la riga: i nodi vedono la riga come `row`. I data source sono della schermata: dentro l'area si usano i valori di `row`.",
                "properties": {
                  "components": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/$defs/node"
                    }
                  },
                  "expandIf": {
                    "$ref": "#/$defs/expression",
                    "description": "Quali righe si possono espandere (espressione con row); tutte se assente."
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "form"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "type": "object",
            "required": [
              "fields"
            ],
            "properties": {
              "source": {
                "type": "string",
                "description": "Nome del data source che fornisce i valori iniziali (assente nei form di inserimento)."
              },
              "initial": {
                "type": "object",
                "description": "Valori iniziali con espressioni, risolti una sola volta all'apertura; per esempio {\"tipo\": \"{{params.tipo}}\"}."
              },
              "fields": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/field"
                }
              },
              "actions": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/action"
                }
              },
              "columns": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4,
                "description": "Colonne della griglia dei campi (1 se assente). Con poco spazio il form torna a una colonna."
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "tabs"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "type": "object",
            "required": [
              "tabs"
            ],
            "properties": {
              "tabs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/tab"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "detail"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "type": "object",
            "required": [
              "source",
              "fields"
            ],
            "properties": {
              "title": {
                "type": "string"
              },
              "source": {
                "type": "string",
                "description": "Nome del data source che restituisce un solo record (un oggetto)."
              },
              "fields": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/column"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "alert"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "type": "object",
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "info",
                  "success",
                  "error"
                ],
                "description": "Aspetto del messaggio; info se assente."
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "stats"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "type": "object",
            "required": [
              "items"
            ],
            "properties": {
              "source": {
                "type": "string",
                "description": "Data source che restituisce un record (oggetto) con i valori; facoltativo se tutti gli indicatori usano value."
              },
              "items": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": {
                  "$ref": "#/$defs/statItem"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "wizard"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "type": "object",
            "required": [
              "steps"
            ],
            "properties": {
              "bind": {
                "$ref": "#/$defs/statePath",
                "description": "Stato con l’indice del passo corrente (da 0): anche un pulsante può spostarlo con set."
              },
              "steps": {
                "type": "array",
                "minItems": 2,
                "maxItems": 10,
                "items": {
                  "$ref": "#/$defs/wizardStep"
                }
              },
              "nextLabel": {
                "type": "string"
              },
              "backLabel": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "tree"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "type": "object",
            "required": [
              "source",
              "labelField"
            ],
            "properties": {
              "source": {
                "type": "string",
                "description": "Data source che restituisce i nodi radice, con i figli annidati."
              },
              "keyField": {
                "type": "string",
                "description": "Campo che identifica il nodo (id se assente)."
              },
              "labelField": {
                "type": "string",
                "description": "Campo mostrato come testo del nodo."
              },
              "childrenField": {
                "type": "string",
                "description": "Campo con i figli (children se assente)."
              },
              "bind": {
                "$ref": "#/$defs/statePath",
                "description": "Stato in cui scrivere la chiave del nodo scelto."
              },
              "searchable": {
                "type": "boolean",
                "description": "Mostra un campo di ricerca che evidenzia i nodi e apre i rami corrispondenti."
              },
              "expandAll": {
                "type": "boolean",
                "description": "Tutti i rami aperti all’inizio (solo il primo livello se assente)."
              },
              "onSelect": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/step"
                },
                "description": "Passi eseguiti alla scelta di un nodo, che vedono il nodo in `row`."
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "calendar"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "type": "object",
            "required": [
              "source",
              "dateField",
              "labelField"
            ],
            "properties": {
              "source": {
                "type": "string",
                "description": "Data source con gli eventi (un elenco di righe)."
              },
              "dateField": {
                "type": "string",
                "description": "Campo con la data dell’evento (AAAA-MM-GG, anche con l’ora)."
              },
              "labelField": {
                "type": "string",
                "description": "Campo mostrato come testo dell’evento."
              },
              "badgeField": {
                "type": "string",
                "description": "Campo che decide il colore dell’evento secondo `badges`."
              },
              "badges": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/$defs/tone"
                }
              },
              "bind": {
                "$ref": "#/$defs/statePath",
                "description": "Stato con il mese visibile (AAAA-MM), da usare nei parametri del data source."
              },
              "maxPerDay": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10,
                "description": "Eventi mostrati per giorno; gli altri diventano «+n» (3 se assente)."
              },
              "onSelect": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/step"
                },
                "description": "Passi eseguiti al clic su un evento, che vedono l’evento in `row`."
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "chart"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "type": "object",
            "required": [
              "kind",
              "source",
              "categoryField",
              "series"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "bar",
                  "line",
                  "pie"
                ],
                "description": "Barre, linee o torta (la torta usa la prima serie)."
              },
              "source": {
                "type": "string",
                "description": "Data source con le righe (una per categoria)."
              },
              "categoryField": {
                "type": "string",
                "description": "Campo con la categoria (asse orizzontale o fetta)."
              },
              "categoryFormat": {
                "enum": [
                  "text",
                  "date",
                  "month"
                ],
                "description": "Come mostrare la categoria: testo, data (AAAA-MM-GG) o mese (AAAA-MM)."
              },
              "categoryKey": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]+$",
                "minLength": 1,
                "maxLength": 100,
                "description": "Prefisso delle chiavi di traduzione delle categorie (t('<prefisso>.<valore>'))."
              },
              "series": {
                "type": "array",
                "minItems": 1,
                "maxItems": 6,
                "items": {
                  "$ref": "#/$defs/chartSeries"
                }
              },
              "format": {
                "enum": [
                  "number",
                  "currency",
                  "percent"
                ],
                "description": "Formato dei valori (number se assente)."
              },
              "currency": {
                "type": "string",
                "pattern": "^[A-Z]{3}$",
                "description": "Codice ISO 4217 per format currency (EUR se assente)."
              },
              "decimals": {
                "type": "integer",
                "minimum": 0,
                "maximum": 6,
                "description": "Decimali mostrati con format number (fino a 2 se assente)."
              },
              "height": {
                "type": "integer",
                "minimum": 160,
                "maximum": 600,
                "description": "Altezza in pixel (280 se assente)."
              },
              "caption": {
                "type": "string",
                "description": "Didascalia della tabella equivalente letta dagli screen reader."
              },
              "stacked": {
                "type": "boolean",
                "description": "Barre impilate invece che affiancate (i valori negativi si impilano verso il basso)."
              },
              "rightFormat": {
                "enum": [
                  "number",
                  "currency",
                  "percent"
                ],
                "description": "Formato dei valori dell’asse destro (come format se assente)."
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "dataTable"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "type": "object",
            "required": [
              "source",
              "columns"
            ],
            "properties": {
              "source": {
                "type": "string",
                "description": "Data source con le righe da analizzare in pagina (tutte caricate: niente paginazione lato server)."
              },
              "columns": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/dataColumn"
                }
              },
              "groupBy": {
                "type": "array",
                "maxItems": 3,
                "uniqueItems": true,
                "items": {
                  "type": "string"
                },
                "description": "Colonne di raggruppamento iniziali (groupable), in ordine."
              },
              "defaultSort": {
                "$ref": "#/$defs/sortSpec"
              },
              "pageSize": {
                "type": "integer",
                "minimum": 5,
                "maximum": 100,
                "description": "Elementi per pagina, intestazioni dei gruppi comprese (10 se assente)."
              },
              "rowActions": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/action"
                }
              },
              "rowActionsInline": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "stepConfirm": {
      "type": "object",
      "required": [
        "confirm"
      ],
      "additionalProperties": false,
      "properties": {
        "confirm": {
          "type": "string",
          "description": "Domanda posta all'utente prima di proseguire; può contenere espressioni, per esempio \"Approvare l'ordine {{row.numero}}?\". Se l'utente rinuncia la sequenza si ferma, senza messaggi di errore."
        }
      }
    },
    "tone": {
      "enum": [
        "neutral",
        "primary",
        "success",
        "danger"
      ],
      "description": "Tono di colore, preso dal tema."
    },
    "tab": {
      "type": "object",
      "required": [
        "label",
        "components"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string"
        },
        "visibleIf": {
          "$ref": "#/$defs/expression"
        },
        "hiddenIf": {
          "$ref": "#/$defs/expression"
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      }
    },
    "columnProps": {
      "type": "object",
      "required": [
        "field"
      ],
      "properties": {
        "field": {
          "type": "string",
          "description": "Nome del campo nella riga restituita dal servizio."
        },
        "label": {
          "type": "string"
        },
        "format": {
          "enum": [
            "text",
            "number",
            "currency",
            "percent",
            "date",
            "datetime",
            "boolean",
            "badge"
          ],
          "description": "Come mostrare il valore: number (numero con le cifre separate secondo la lingua, `decimals` decimali), currency (importo con simbolo), percent (il valore è già in punti percentuali, 10 = 10 %), date e datetime (testo ISO 8601), boolean (Sì/No), badge (etichetta colorata secondo `badges`)."
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "Codice ISO 4217 per format currency (EUR se assente)."
        },
        "badges": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/tone"
          },
          "description": "Per format badge: colore per ogni valore; i valori non elencati sono neutri."
        },
        "visibleIf": {
          "$ref": "#/$defs/expression"
        },
        "hiddenIf": {
          "$ref": "#/$defs/expression"
        },
        "tooltip": {
          "type": "string",
          "description": "Testo di aiuto mostrato al passaggio del mouse o con il focus. Solo testo (mai HTML); può contenere {{ }}."
        },
        "valueKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$",
          "minLength": 1,
          "maxLength": 100,
          "description": "Prefisso delle chiavi di traduzione per i valori mostrati: il testo è t('<prefisso>.<valore>'), con il valore come ripiego. I colori dei badge restano legati al valore originale."
        },
        "decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6,
          "description": "Decimali mostrati con format number (fino a 2 se assente)."
        }
      }
    },
    "tableColumnProps": {
      "type": "object",
      "$ref": "#/$defs/columnProps",
      "properties": {
        "sortable": {
          "type": "boolean",
          "description": "La colonna si può ordinare (frecce nell'intestazione)."
        },
        "onClick": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          },
          "description": "Il valore diventa un collegamento che esegue questi passi con la riga in `row`."
        },
        "aggregate": {
          "enum": [
            "sum",
            "avg",
            "min",
            "max",
            "count"
          ],
          "description": "Valore della colonna nella riga dei totali (somma, media, minimo, massimo, conteggio), calcolato sulle righe caricate."
        }
      }
    },
    "tableColumn": {
      "type": "object",
      "$ref": "#/$defs/tableColumnProps",
      "unevaluatedProperties": false
    },
    "statePath": {
      "type": "string",
      "pattern": "^state(\\.[A-Za-z][A-Za-z0-9]*)+$",
      "description": "Percorso nello stato della schermata, per esempio state.ordinamento."
    },
    "sortSpec": {
      "type": "object",
      "required": [
        "field",
        "direction"
      ],
      "additionalProperties": false,
      "properties": {
        "field": {
          "type": "string"
        },
        "direction": {
          "enum": [
            "asc",
            "desc"
          ]
        }
      }
    },
    "stepDialog": {
      "type": "object",
      "required": [
        "dialog"
      ],
      "additionalProperties": false,
      "properties": {
        "dialog": {
          "type": "object",
          "required": [
            "title",
            "fields",
            "onSubmit"
          ],
          "additionalProperties": false,
          "description": "Finestra con un form: i passi di onSubmit vedono i valori in `form`. Se riescono la finestra si chiude e la sequenza prosegue; se l’utente annulla la sequenza si ferma in silenzio.",
          "properties": {
            "title": {
              "type": "string"
            },
            "fields": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/field"
              }
            },
            "initial": {
              "type": "object",
              "description": "Valori iniziali con espressioni (per esempio {\"nota\": \"{{ row.nota }}\"})."
            },
            "columns": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            },
            "submitLabel": {
              "type": "string"
            },
            "onSubmit": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/step"
              }
            }
          }
        }
      }
    },
    "statItem": {
      "type": "object",
      "required": [
        "label"
      ],
      "additionalProperties": false,
      "description": "Un indicatore: etichetta e valore grande. Il valore viene da un campo del record del data source (`field`) o da un'espressione (`value`, che vede il record come `row`).",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string"
        },
        "field": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/expression"
        },
        "format": {
          "enum": [
            "text",
            "number",
            "currency",
            "percent",
            "date",
            "datetime",
            "boolean",
            "badge"
          ]
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "Codice ISO 4217 per format currency (EUR se assente)."
        },
        "decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6,
          "description": "Decimali mostrati con format number (fino a 2 se assente)."
        },
        "valueKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$",
          "minLength": 1,
          "maxLength": 100,
          "description": "Prefisso delle chiavi di traduzione per i valori mostrati: il testo è t('<prefisso>.<valore>'), con il valore come ripiego. I colori dei badge restano legati al valore originale."
        },
        "tone": {
          "$ref": "#/$defs/tone"
        },
        "caption": {
          "type": "string",
          "description": "Riga piccola sotto il valore (per esempio un confronto); può contenere {{ }} con il record come row."
        },
        "tooltip": {
          "type": "string",
          "description": "Testo di aiuto mostrato al passaggio del mouse o con il focus. Solo testo (mai HTML); può contenere {{ }}."
        },
        "visibleIf": {
          "$ref": "#/$defs/expression"
        },
        "hiddenIf": {
          "$ref": "#/$defs/expression"
        }
      },
      "anyOf": [
        {
          "required": [
            "field"
          ],
          "properties": {
            "field": true
          }
        },
        {
          "required": [
            "value"
          ],
          "properties": {
            "value": true
          }
        }
      ]
    },
    "wizardStep": {
      "type": "object",
      "required": [
        "label",
        "components"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "nextIf": {
          "$ref": "#/$defs/expression",
          "description": "Avanti è abilitato solo se l’espressione è vera (sempre, se assente)."
        }
      }
    },
    "chartSeries": {
      "type": "object",
      "required": [
        "field"
      ],
      "additionalProperties": false,
      "properties": {
        "field": {
          "type": "string",
          "description": "Campo numerico delle righe."
        },
        "label": {
          "type": "string"
        },
        "tone": {
          "$ref": "#/$defs/tone",
          "description": "Colore della serie dal tema (altrimenti la tavolozza del grafico)."
        },
        "kind": {
          "enum": [
            "bar",
            "line"
          ],
          "description": "Come disegnare questa serie in un grafico a barre o a linee (grafici combinati); se assente vale il tipo del grafico."
        },
        "axis": {
          "enum": [
            "left",
            "right"
          ],
          "description": "Asse dei valori della serie: a destra per grandezze diverse (per esempio una percentuale accanto a importi)."
        }
      }
    },
    "dataColumn": {
      "type": "object",
      "$ref": "#/$defs/tableColumnProps",
      "properties": {
        "filter": {
          "enum": [
            "text",
            "select",
            "number",
            "date"
          ],
          "description": "Filtro nell’intestazione: testo (contiene), scelta tra i valori presenti, intervallo numerico o di date."
        },
        "groupable": {
          "type": "boolean",
          "description": "La colonna si può scegliere per raggruppare le righe."
        }
      },
      "unevaluatedProperties": false
    }
  }
}
