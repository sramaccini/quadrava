{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lowcode.example/schemas/screen.schema.json",
  "title": "Schermata",
  "description": "Nucleo del linguaggio di definizione: una schermata di un'applicazione LowCode con il catalogo dei componenti di base.",
  "type": "object",
  "required": [
    "schemaVersion",
    "screen",
    "components"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$"
    },
    "screen": {
      "$ref": "#/$defs/id",
      "description": "Identificativo stabile della schermata."
    },
    "title": {
      "type": "string"
    },
    "requires": {
      "$ref": "#/$defs/permission",
      "description": "Permesso necessario per aprire la schermata."
    },
    "dataSources": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/dataSource"
      }
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "description": {
      "type": "string",
      "maxLength": 300,
      "description": "Frase mostrata sotto il titolo, nell'intestazione di pagina."
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Identificativo in kebab-case. Una volta pubblicato non cambia."
    },
    "permission": {
      "type": "string",
      "pattern": "^[a-z0-9]+\\.[a-z0-9]+\\.[a-z0-9]+$",
      "description": "Permesso nel formato dominio.risorsa.azione (tre parti, per esempio ordini.ordine.approva)."
    },
    "expression": {
      "type": "string",
      "pattern": "^\\{\\{[\\s\\S]+\\}\\}$",
      "description": "Espressione CEL tra doppie graffe, per esempio {{can('ordini.ordine.approva') && row.stato == 'inviato'}}. Variabili disponibili: user, state, params, row, form, value. Funzione disponibile: can(permesso)."
    },
    "dataSource": {
      "type": "object",
      "required": [
        "type",
        "method",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "rest"
        },
        "method": {
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ]
        },
        "url": {
          "type": "string"
        },
        "params": {
          "type": "object",
          "description": "Parametri di query (GET, DELETE)."
        },
        "body": {
          "description": "Corpo della richiesta (POST, PUT, PATCH): un oggetto con espressioni oppure una sola espressione, per esempio {{form}}. Se manca si usa params.",
          "oneOf": [
            {
              "type": "object"
            },
            {
              "$ref": "#/$defs/expression"
            }
          ]
        },
        "paging": {
          "enum": [
            "server",
            "none"
          ]
        }
      }
    },
    "step": {
      "oneOf": [
        {
          "$ref": "#/$defs/stepCall"
        },
        {
          "$ref": "#/$defs/stepRefresh"
        },
        {
          "$ref": "#/$defs/stepNavigate"
        },
        {
          "$ref": "#/$defs/stepToast"
        },
        {
          "$ref": "#/$defs/stepSet"
        },
        {
          "$ref": "#/$defs/stepConfirm"
        }
      ]
    },
    "steps": {
      "oneOf": [
        {
          "$ref": "#/$defs/step"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      ]
    },
    "stepCall": {
      "type": "object",
      "required": [
        "call"
      ],
      "additionalProperties": false,
      "properties": {
        "call": {
          "type": "string",
          "description": "Nome del data source da eseguire."
        },
        "args": {
          "type": "object"
        },
        "onError": {
          "$ref": "#/$defs/steps"
        }
      }
    },
    "stepRefresh": {
      "type": "object",
      "required": [
        "refresh"
      ],
      "additionalProperties": false,
      "properties": {
        "refresh": {
          "type": "string",
          "description": "Nome del data source da ricaricare."
        }
      }
    },
    "stepNavigate": {
      "type": "object",
      "required": [
        "navigate"
      ],
      "additionalProperties": false,
      "properties": {
        "navigate": {
          "$ref": "#/$defs/id"
        },
        "params": {
          "type": "object"
        }
      }
    },
    "stepToast": {
      "type": "object",
      "required": [
        "toast"
      ],
      "additionalProperties": false,
      "properties": {
        "toast": {
          "type": "string"
        }
      }
    },
    "stepSet": {
      "type": "object",
      "required": [
        "set"
      ],
      "additionalProperties": false,
      "properties": {
        "set": {
          "type": "object",
          "required": [
            "path",
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string"
            },
            "value": {}
          }
        }
      }
    },
    "action": {
      "type": "object",
      "required": [
        "label",
        "onClick"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string"
        },
        "visibleIf": {
          "$ref": "#/$defs/expression"
        },
        "hiddenIf": {
          "$ref": "#/$defs/expression"
        },
        "enabledIf": {
          "$ref": "#/$defs/expression"
        },
        "onClick": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "tooltip": {
          "type": "string",
          "description": "Testo di aiuto mostrato al passaggio del mouse o con il focus. Solo testo (mai HTML); può contenere {{ }}."
        }
      }
    },
    "field": {
      "type": "object",
      "required": [
        "name",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z][A-Za-z0-9]*$"
        },
        "type": {
          "enum": [
            "text",
            "number",
            "select",
            "checkbox",
            "date"
          ]
        },
        "label": {
          "type": "string"
        },
        "required": {
          "type": "boolean"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sensitive": {
          "type": "boolean",
          "description": "Il valore non compare mai in tracce e log."
        },
        "visibleIf": {
          "$ref": "#/$defs/expression"
        },
        "hiddenIf": {
          "$ref": "#/$defs/expression"
        },
        "readOnlyIf": {
          "$ref": "#/$defs/expression"
        },
        "validate": {
          "type": "object",
          "required": [
            "rule",
            "message"
          ],
          "additionalProperties": false,
          "properties": {
            "rule": {
              "$ref": "#/$defs/expression"
            },
            "message": {
              "type": "string"
            }
          }
        },
        "tooltip": {
          "type": "string",
          "description": "Testo di aiuto mostrato al passaggio del mouse o con il focus. Solo testo (mai HTML); può contenere {{ }}."
        },
        "optionKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$",
          "minLength": 1,
          "maxLength": 100,
          "description": "Prefisso delle chiavi di traduzione per le etichette delle opzioni: l'etichetta di un'opzione è t('<prefisso>.<valore>'), con il valore come ripiego."
        }
      }
    },
    "column": {
      "type": "object",
      "$ref": "#/$defs/columnProps",
      "unevaluatedProperties": false
    },
    "node": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": [
            "section",
            "text",
            "button",
            "filterBar",
            "table",
            "form",
            "tabs",
            "detail",
            "alert"
          ]
        },
        "visibleIf": {
          "$ref": "#/$defs/expression"
        },
        "hiddenIf": {
          "$ref": "#/$defs/expression"
        },
        "enabledIf": {
          "$ref": "#/$defs/expression"
        },
        "readOnlyIf": {
          "$ref": "#/$defs/expression"
        },
        "tooltip": {
          "type": "string",
          "description": "Testo di aiuto mostrato al passaggio del mouse o con il focus. Solo testo (mai HTML); può contenere {{ }}."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "section"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "type": "object",
            "required": [
              "components"
            ],
            "properties": {
              "title": {
                "type": "string"
              },
              "components": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/node"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "text"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "type": "object",
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "style": {
                "enum": [
                  "heading",
                  "body"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "button"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "type": "object",
            "required": [
              "label",
              "onClick"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "onClick": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/step"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "filterBar"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "type": "object",
            "required": [
              "bind",
              "fields"
            ],
            "properties": {
              "bind": {
                "type": "string",
                "description": "Percorso nello stato della schermata, per esempio state.filtri."
              },
              "fields": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/field"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "table"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "type": "object",
            "required": [
              "source",
              "columns"
            ],
            "properties": {
              "source": {
                "type": "string",
                "description": "Nome del data source che fornisce le righe."
              },
              "columns": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/tableColumn"
                }
              },
              "rowActions": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/action"
                }
              },
              "sort": {
                "type": "object",
                "additionalProperties": false,
                "description": "Ordinamento. Con paging server lo fa il servizio: la tabella scrive { field, direction } nello stato `bind`; altrimenti ordina in pagina le righe caricate.",
                "properties": {
                  "bind": {
                    "$ref": "#/$defs/statePath"
                  },
                  "default": {
                    "$ref": "#/$defs/sortSpec",
                    "description": "Ordinamento all'apertura della schermata."
                  }
                }
              },
              "selection": {
                "type": "object",
                "required": [
                  "bind"
                ],
                "additionalProperties": false,
                "description": "Selezione delle righe: le chiavi delle righe scelte stanno nello stato `bind`; le azioni multiple vedono le righe intere in `selection`.",
                "properties": {
                  "bind": {
                    "$ref": "#/$defs/statePath"
                  },
                  "key": {
                    "type": "string",
                    "description": "Campo che identifica la riga (id se assente)."
                  }
                }
              },
              "bulkActions": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/action"
                },
                "description": "Azioni sulle righe selezionate, sopra la tabella. Le espressioni vedono `selection` (elenco delle righe scelte)."
              },
              "rowActionsInline": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10,
                "description": "Quante azioni di riga (visibili) mostrare come pulsanti; le altre finiscono nel menu «⋯». 0 = tutte nel menu; se manca, tutte pulsanti."
              },
              "expand": {
                "type": "object",
                "required": [
                  "components"
                ],
                "additionalProperties": false,
                "description": "Area che si apre sotto la riga: i nodi vedono la riga come `row`. I data source sono della schermata: dentro l'area si usano i valori di `row`.",
                "properties": {
                  "components": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "#/$defs/node"
                    }
                  },
                  "expandIf": {
                    "$ref": "#/$defs/expression",
                    "description": "Quali righe si possono espandere (espressione con row); tutte se assente."
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "form"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "type": "object",
            "required": [
              "fields"
            ],
            "properties": {
              "source": {
                "type": "string",
                "description": "Nome del data source che fornisce i valori iniziali (assente nei form di inserimento)."
              },
              "initial": {
                "type": "object",
                "description": "Valori iniziali con espressioni, risolti una sola volta all'apertura; per esempio {\"tipo\": \"{{params.tipo}}\"}."
              },
              "fields": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/field"
                }
              },
              "actions": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/action"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "tabs"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "type": "object",
            "required": [
              "tabs"
            ],
            "properties": {
              "tabs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/tab"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "detail"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "type": "object",
            "required": [
              "source",
              "fields"
            ],
            "properties": {
              "title": {
                "type": "string"
              },
              "source": {
                "type": "string",
                "description": "Nome del data source che restituisce un solo record (un oggetto)."
              },
              "fields": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/column"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "alert"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "type": "object",
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "info",
                  "success",
                  "error"
                ],
                "description": "Aspetto del messaggio; info se assente."
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "stepConfirm": {
      "type": "object",
      "required": [
        "confirm"
      ],
      "additionalProperties": false,
      "properties": {
        "confirm": {
          "type": "string",
          "description": "Domanda posta all'utente prima di proseguire; può contenere espressioni, per esempio \"Approvare l'ordine {{row.numero}}?\". Se l'utente rinuncia la sequenza si ferma, senza messaggi di errore."
        }
      }
    },
    "tone": {
      "enum": [
        "neutral",
        "primary",
        "success",
        "danger"
      ],
      "description": "Tono di colore, preso dal tema."
    },
    "tab": {
      "type": "object",
      "required": [
        "label",
        "components"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string"
        },
        "visibleIf": {
          "$ref": "#/$defs/expression"
        },
        "hiddenIf": {
          "$ref": "#/$defs/expression"
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      }
    },
    "columnProps": {
      "type": "object",
      "required": [
        "field"
      ],
      "properties": {
        "field": {
          "type": "string",
          "description": "Nome del campo nella riga restituita dal servizio."
        },
        "label": {
          "type": "string"
        },
        "format": {
          "enum": [
            "text",
            "currency",
            "percent",
            "date",
            "datetime",
            "boolean",
            "badge"
          ],
          "description": "Come mostrare il valore: currency (importo con simbolo), percent (il valore è già in punti percentuali, 10 = 10 %), date e datetime (testo ISO 8601), boolean (Sì/No), badge (etichetta colorata secondo `badges`)."
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "Codice ISO 4217 per format currency (EUR se assente)."
        },
        "badges": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/tone"
          },
          "description": "Per format badge: colore per ogni valore; i valori non elencati sono neutri."
        },
        "visibleIf": {
          "$ref": "#/$defs/expression"
        },
        "hiddenIf": {
          "$ref": "#/$defs/expression"
        },
        "tooltip": {
          "type": "string",
          "description": "Testo di aiuto mostrato al passaggio del mouse o con il focus. Solo testo (mai HTML); può contenere {{ }}."
        },
        "valueKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$",
          "minLength": 1,
          "maxLength": 100,
          "description": "Prefisso delle chiavi di traduzione per i valori mostrati: il testo è t('<prefisso>.<valore>'), con il valore come ripiego. I colori dei badge restano legati al valore originale."
        }
      }
    },
    "tableColumnProps": {
      "type": "object",
      "$ref": "#/$defs/columnProps",
      "properties": {
        "sortable": {
          "type": "boolean",
          "description": "La colonna si può ordinare (frecce nell'intestazione)."
        }
      }
    },
    "tableColumn": {
      "type": "object",
      "$ref": "#/$defs/tableColumnProps",
      "unevaluatedProperties": false
    },
    "statePath": {
      "type": "string",
      "pattern": "^state(.[A-Za-z][A-Za-z0-9]*)+$",
      "description": "Percorso nello stato della schermata, per esempio state.ordinamento."
    },
    "sortSpec": {
      "type": "object",
      "required": [
        "field",
        "direction"
      ],
      "additionalProperties": false,
      "properties": {
        "field": {
          "type": "string"
        },
        "direction": {
          "enum": [
            "asc",
            "desc"
          ]
        }
      }
    }
  }
}
