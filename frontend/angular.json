{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "runtime": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/runtime",
      "sourceRoot": "projects/runtime/src",
      "prefix": "lc",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/runtime/src/main.ts",
            "tsConfig": "projects/runtime/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/runtime/public"
              }
            ],
            "styles": [
              "node_modules/ng-zorro-antd/ng-zorro-antd.variable.min.css",
              {
                "input": "node_modules/ng-zorro-antd/ng-zorro-antd.dark.min.css",
                "bundleName": "nz-dark",
                "inject": false
              },
              "projects/runtime/src/styles.scss"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2.5MB",
                  "maximumError": "4MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "registro": {
              "assets": [
                {
                  "glob": "**/*",
                  "input": "projects/runtime/public",
                  "ignore": [
                    "runtime-config.json"
                  ]
                },
                {
                  "glob": "runtime-config.json",
                  "input": "projects/runtime/config/registro",
                  "output": "/"
                }
              ]
            },
            "bff": {
              "assets": [
                {
                  "glob": "**/*",
                  "input": "projects/runtime/public",
                  "ignore": [
                    "runtime-config.json"
                  ]
                },
                {
                  "glob": "runtime-config.json",
                  "input": "projects/runtime/config/bff",
                  "output": "/"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "runtime:build:production"
            },
            "development": {
              "buildTarget": "runtime:build:development"
            },
            "registro": {
              "buildTarget": "runtime:build:development,registro",
              "proxyConfig": "proxy.registry.json"
            },
            "bff": {
              "buildTarget": "runtime:build:development,bff",
              "proxyConfig": "proxy.bff.json"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    },
    "editor": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/editor",
      "sourceRoot": "projects/editor/src",
      "prefix": "lc",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/editor/src/main.ts",
            "tsConfig": "projects/editor/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/editor/public"
              }
            ],
            "styles": [
              "node_modules/ng-zorro-antd/ng-zorro-antd.variable.min.css",
              {
                "input": "node_modules/ng-zorro-antd/ng-zorro-antd.dark.min.css",
                "bundleName": "nz-dark",
                "inject": false
              },
              "projects/editor/src/styles.scss"
            ],
            "allowedCommonJsDependencies": [
              "ajv",
              "ajv/dist/2020.js"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2.5MB",
                  "maximumError": "4MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "editor:build:production"
            },
            "development": {
              "buildTarget": "editor:build:development"
            },
            "registro": {
              "buildTarget": "editor:build:development",
              "proxyConfig": "proxy.registry.json"
            },
            "bff": {
              "buildTarget": "editor:build:development",
              "proxyConfig": "proxy.bff.json"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    },
    "schema": {
      "projectType": "library",
      "root": "projects/schema",
      "sourceRoot": "projects/schema/src",
      "prefix": "lc",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/schema/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/schema/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/schema/tsconfig.spec.json"
          }
        }
      }
    },
    "core": {
      "projectType": "library",
      "root": "projects/core",
      "sourceRoot": "projects/core/src",
      "prefix": "lc",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/core/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/core/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/core/tsconfig.spec.json"
          }
        }
      }
    },
    "expressions": {
      "projectType": "library",
      "root": "projects/expressions",
      "sourceRoot": "projects/expressions/src",
      "prefix": "lc",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/expressions/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/expressions/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/expressions/tsconfig.spec.json"
          }
        }
      }
    },
    "services": {
      "projectType": "library",
      "root": "projects/services",
      "sourceRoot": "projects/services/src",
      "prefix": "lc",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/services/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/services/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/services/tsconfig.spec.json"
          }
        }
      }
    },
    "components": {
      "projectType": "library",
      "root": "projects/components",
      "sourceRoot": "projects/components/src",
      "prefix": "lc",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/components/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/components/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/components/tsconfig.spec.json"
          }
        }
      }
    }
  }
}
