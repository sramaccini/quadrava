{
  "schemaVersion": "1.0",
  "datasources": "medical-staff",
  "description": "Calls of the medical staff service: list with filters and pages, read, create, update, delete.",
  "baseUrl": "{{ settings.staffApi }}",
  "sources": {
    "list": {
      "type": "rest",
      "method": "GET",
      "url": "/",
      "paging": "server",
      "params": {
        "page": "{{state.page}}"
      }
    },
    "get": {
      "type": "rest",
      "method": "GET",
      "url": "/{{params.id}}"
    },
    "create": {
      "type": "rest",
      "method": "POST",
      "url": "/",
      "body": "{{form}}"
    },
    "update": {
      "type": "rest",
      "method": "PUT",
      "url": "/{{params.id}}",
      "body": "{{form}}"
    },
    "remove": {
      "type": "rest",
      "method": "DELETE",
      "url": "/{{id}}"
    },
    "export": {
      "type": "rest",
      "method": "GET",
      "url": "/"
    }
  }
}
