{
  "realm": "lowcode",
  "displayName": "Quadrava",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "roles": {
    "realm": [
      {
        "name": "operator",
        "description": "Reads and edits orders"
      },
      {
        "name": "manager",
        "description": "Like operator, and approves orders"
      },
      {
        "name": "administrator",
        "description": "Every permission of the sample application"
      }
    ]
  },
  "clients": [
    {
      "clientId": "lowcode-bff",
      "name": "Quadrava BFF",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "dev-only-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8080/login/oauth2/code/keycloak",
        "http://localhost:8090/login/oauth2/code/keycloak"
      ],
      "webOrigins": [
        "http://localhost:4200",
        "http://localhost:4201",
        "http://localhost:8090"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8080/*##http://localhost:8090/*"
      }
    },
    {
      "clientId": "lowcode-tools",
      "name": "Quadrava development tools (local scripts, never in production)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false
    }
  ],
  "users": [
    {
      "username": "operator",
      "enabled": true,
      "email": "operator@example.test",
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "Operator",
      "credentials": [
        {
          "type": "password",
          "value": "operator",
          "temporary": false
        }
      ],
      "realmRoles": [
        "operator"
      ]
    },
    {
      "username": "manager",
      "enabled": true,
      "email": "manager@example.test",
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "Manager",
      "credentials": [
        {
          "type": "password",
          "value": "manager",
          "temporary": false
        }
      ],
      "realmRoles": [
        "manager"
      ]
    },
    {
      "username": "administrator",
      "enabled": true,
      "email": "administrator@example.test",
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "Administrator",
      "credentials": [
        {
          "type": "password",
          "value": "administrator",
          "temporary": false
        }
      ],
      "realmRoles": [
        "administrator"
      ]
    }
  ]
}
