{
  "schemaVersion": "1.0",
  "screen": "fattura-nuova",
  "title": "{{ t('fattura_nuova.nuova_fattura', 'Nuova fattura') }}",
  "requires": "fatture.fattura.crea",
  "dataSources": {
    "creaFattura": {
      "type": "rest",
      "method": "POST",
      "url": "/api/fatture",
      "body": "{{form}}"
    }
  },
  "components": [
    {
      "id": "form-fattura",
      "type": "form",
      "initial": {
        "tipo": "{{has(params.tipo) ? params.tipo : 'attiva'}}"
      },
      "fields": [
        {
          "name": "numero",
          "type": "text",
          "label": "{{ t('comune.numero', 'Numero') }}",
          "required": true
        },
        {
          "name": "cliente",
          "type": "text",
          "label": "{{ t('fattura_nuova.cliente_fornitore', 'Cliente / fornitore') }}",
          "required": true
        },
        {
          "name": "tipo",
          "type": "select",
          "label": "{{ t('comune.tipo', 'Tipo') }}",
          "options": [
            "attiva",
            "passiva"
          ],
          "required": true,
          "optionKey": "valori.tipo"
        },
        {
          "name": "importo",
          "type": "number",
          "label": "{{ t('comune.importo', 'Importo (€)') }}",
          "required": true,
          "validate": {
            "rule": "{{value > 0}}",
            "message": "{{ t('fattura_nuova.l_importo_deve_essere_maggiore_d', 'L\\'importo deve essere maggiore di zero') }}"
          }
        },
        {
          "name": "data",
          "type": "date",
          "label": "{{ t('fattura_nuova.data', 'Data') }}"
        }
      ],
      "actions": [
        {
          "id": "btn-salva",
          "label": "{{ t('fattura_nuova.salva_come_bozza', 'Salva come bozza') }}",
          "enabledIf": "{{can('fatture.fattura.crea')}}",
          "onClick": [
            {
              "call": "creaFattura",
              "onError": {
                "toast": "{{ t('comune.salvataggio_non_riuscito', 'Salvataggio non riuscito') }}"
              }
            },
            {
              "toast": "{{ t('fattura_nuova.fattura_salvata_in_bozza', 'Fattura salvata in bozza') }}"
            },
            {
              "navigate": "fatture-elenco",
              "params": {
                "stato": "bozza"
              }
            }
          ]
        }
      ]
    }
  ]
}
