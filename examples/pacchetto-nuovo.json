{
  "schemaVersion": "1.0",
  "screen": "pacchetto-nuovo",
  "title": "{{ t('pacchetto_nuovo.nuovo_pacchetto', 'Nuovo pacchetto') }}",
  "requires": "pacchetti.pacchetto.crea",
  "dataSources": {
    "creaPacchetto": {
      "type": "rest",
      "method": "POST",
      "url": "/api/pacchetti",
      "body": "{{form}}"
    }
  },
  "components": [
    {
      "id": "form-pacchetto",
      "type": "form",
      "fields": [
        {
          "name": "nome",
          "type": "text",
          "label": "{{ t('pacchetto_nuovo.nome_del_pacchetto', 'Nome del pacchetto') }}",
          "required": true
        },
        {
          "name": "descrizione",
          "type": "text",
          "label": "{{ t('comune.descrizione', 'Descrizione') }}"
        }
      ],
      "actions": [
        {
          "id": "btn-crea",
          "label": "{{ t('pacchetto_nuovo.crea_pacchetto', 'Crea pacchetto') }}",
          "enabledIf": "{{can('pacchetti.pacchetto.crea')}}",
          "onClick": [
            {
              "call": "creaPacchetto",
              "onError": {
                "toast": "{{ t('pacchetto_nuovo.creazione_non_riuscita', 'Creazione non riuscita') }}"
              }
            },
            {
              "toast": "{{ t('pacchetto_nuovo.pacchetto_creato', 'Pacchetto creato') }}"
            },
            {
              "navigate": "pacchetti-elenco"
            }
          ]
        }
      ]
    }
  ]
}
