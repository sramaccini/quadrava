{
  "schemaVersion": "1.0",
  "screen": "vetrina-layout",
  "title": "Vetrina: schede, dettaglio e messaggi",
  "requires": "vetrina.componenti.leggi",
  "dataSources": {
    "ordine": { "type": "rest", "method": "GET", "url": "/api/ordini/{{has(params.id) ? params.id : 1}}" },
    "fatture": { "type": "rest", "method": "GET", "url": "/api/fatture", "params": { "stato": "pagata" } },
    "eliminaBozza": { "type": "rest", "method": "POST", "url": "/api/vetrina/segnala" }
  },
  "components": [
    { "id": "titolo", "type": "text", "style": "heading", "text": "Schede, dettaglio e messaggi" },
    { "id": "avviso-info", "type": "alert", "kind": "info", "text": "Un messaggio in pagina informa senza interrompere: qui è il tipo info." },
    {
      "id": "avviso-sola-lettura",
      "type": "alert",
      "kind": "error",
      "visibleIf": "{{!can('ordini.ordine.scrivi')}}",
      "text": "Il tuo profilo non può modificare gli ordini: questo messaggio sparisce con il permesso ordini.ordine.scrivi (prova il profilo responsabile)."
    },
    {
      "id": "schede",
      "type": "tabs",
      "tabs": [
        {
          "id": "scheda-dati",
          "label": "Dati dell'ordine",
          "components": [
            {
              "id": "dettaglio-ordine",
              "type": "detail",
              "source": "ordine",
              "title": "Ordine in sola lettura",
              "fields": [
                { "field": "numero", "label": "Numero" },
                { "field": "cliente", "label": "Cliente" },
                { "field": "tipo", "label": "Tipo" },
                { "field": "sconto", "label": "Sconto", "format": "percent" },
                { "field": "stato", "label": "Stato", "format": "badge", "badges": { "bozza": "neutral", "inviato": "primary", "approvato": "success" } },
                { "field": "iban", "label": "IBAN", "hiddenIf": "{{!can('ordini.iban.leggi')}}" }
              ]
            }
          ]
        },
        {
          "id": "scheda-fatture",
          "label": "Fatture pagate",
          "components": [
            {
              "id": "tabella-fatture",
              "type": "table",
              "source": "fatture",
              "columns": [
                { "field": "numero", "label": "Numero" },
                { "field": "importo", "label": "Importo", "format": "currency" },
                { "field": "emessa", "label": "Emessa il", "format": "date" },
                { "field": "incassata", "label": "Incassata", "format": "boolean" }
              ]
            }
          ]
        },
        {
          "id": "scheda-azioni",
          "label": "Azioni con conferma",
          "components": [
            { "id": "txt-conferma", "type": "text", "text": "Prima di un'azione delicata si chiede conferma. Se premi Annulla non succede nulla e non compare nessun errore." },
            {
              "id": "btn-elimina",
              "type": "button",
              "label": "Elimina la bozza",
              "onClick": [
                { "confirm": "Eliminare definitivamente la bozza di {{user.username}}?" },
                { "call": "eliminaBozza", "onError": { "toast": "Eliminazione non riuscita" } },
                { "toast": "Bozza eliminata" }
              ]
            }
          ]
        },
        {
          "id": "scheda-riservata",
          "label": "Dati riservati",
          "visibleIf": "{{can('ordini.iban.leggi')}}",
          "components": [
            { "id": "avviso-riservato", "type": "alert", "kind": "success", "text": "Questa scheda esiste solo per chi può leggere gli IBAN: senza il permesso non compare nemmeno il suo titolo." }
          ]
        }
      ]
    }
  ]
}
