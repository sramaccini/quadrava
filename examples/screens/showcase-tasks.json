{
  "schemaVersion": "1.0",
  "screen": "showcase-tasks",
  "title": "{{ t('showcase_tasks.showcase_tasks_and_progress', 'Showcase: tasks and progress') }}",
  "description": "{{ t('showcase_tasks.kanban_with_movable_cards_event', 'Kanban with movable cards, event timeline, progress bars, images and links.') }}",
  "requires": "showcase.components.read",
  "dataSources": {
    "tasks": {
      "ref": "showcase-tasks/tasks"
    },
    "statuses": {
      "ref": "showcase-tasks/statuses"
    },
    "task": {
      "ref": "showcase-tasks/task"
    },
    "taskMoves": {
      "ref": "showcase-tasks/taskMoves"
    },
    "taskWorkflow": {
      "ref": "showcase-tasks/taskWorkflow"
    },
    "moveTask": {
      "ref": "showcase-tasks/moveTask"
    },
    "moveTaskToLane": {
      "ref": "showcase-tasks/moveTaskToLane"
    },
    "events": {
      "ref": "showcase-tasks/events"
    },
    "comments": {
      "ref": "showcase-tasks/comments"
    },
    "addComment": {
      "ref": "showcase-tasks/addComment"
    },
    "updateComment": {
      "ref": "showcase-tasks/updateComment"
    },
    "deleteComment": {
      "ref": "showcase-tasks/deleteComment"
    },
    "people": {
      "ref": "showcase-tasks/people"
    },
    "colleagueMove": {
      "ref": "showcase-tasks/colleagueMove"
    }
  },
  "components": [
    {
      "id": "header",
      "type": "box",
      "align": "center",
      "components": [
        {
          "id": "illustration",
          "type": "image",
          "src": "examples/images/tasks.svg",
          "alt": "{{ t('showcase_tasks.clipboard_with_the_task_list', 'Clipboard with the task list') }}",
          "width": 40,
          "height": 40
        },
        {
          "id": "title",
          "type": "text",
          "style": "heading",
          "text": "{{ t('showcase_tasks.tasks_and_progress', 'Tasks and progress') }}"
        }
      ]
    },
    {
      "id": "section-progress",
      "type": "section",
      "title": "{{ t('showcase_tasks.progress', 'Progress') }}",
      "components": [
        {
          "id": "grid-progress",
          "type": "grid",
          "columns": 3,
          "components": [
            {
              "id": "progress-done",
              "type": "progress",
              "label": "{{ t('showcase_tasks.steps_completed_3_of_5', 'Steps completed (3 of 5)') }}",
              "value": 3,
              "max": 5,
              "tone": "success"
            },
            {
              "id": "progress-budget",
              "type": "progress",
              "label": "{{ t('showcase_tasks.budget_used', 'Budget used') }}",
              "value": 82,
              "tone": "danger"
            },
            {
              "id": "progress-circle",
              "type": "progress",
              "label": "{{ t('showcase_tasks.quarterly_target', 'Quarterly target') }}",
              "value": 64,
              "kind": "circle"
            }
          ]
        }
      ]
    },
    {
      "id": "section-kanban",
      "type": "section",
      "title": "{{ t('showcase_tasks.kanban_drag_a_card_or_use_move_t', 'Kanban: drag a card or use “Move”') }}",
      "components": [
        {
          "id": "kanban",
          "type": "kanban",
          "source": "tasks",
          "columnField": "status",
          "titleField": "title",
          "avatarField": "who",
          "badges": [
            {
              "field": "priority",
              "tones": {
                "high": "danger",
                "normal": "primary"
              },
              "valueKey": "values.priority"
            }
          ],
          "footerFields": [
            {
              "field": "points",
              "label": "{{ t('showcase_tasks.points', 'Points') }}"
            }
          ],
          "columns": [
            {
              "value": "to-do",
              "label": "{{ t('showcase_tasks.to_do', 'To do') }}"
            },
            {
              "value": "in-progress",
              "label": "{{ t('showcase_tasks.in_progress', 'In progress') }}",
              "tone": "primary",
              "limit": 2
            },
            {
              "value": "done",
              "label": "{{ t('showcase_tasks.done', 'Done') }}",
              "tone": "success"
            }
          ],
          "reorder": true,
          "moveIf": "{{ can('showcase.components.read') }}",
          "onMove": [
            {
              "call": "moveTask",
              "args": {
                "id": "{{ row.id }}",
                "status": "{{ to }}",
                "beforeId": "{{ beforeId }}",
                "afterId": "{{ afterId }}"
              },
              "onError": {
                "toast": "{{ t('showcase_tasks.move_failed', 'Move failed') }}"
              }
            },
            {
              "refresh": "tasks"
            },
            {
              "toast": "{{ t('showcase_tasks.moved', '“{title}” moved', {'title': row.title}) }}"
            }
          ],
          "onOpen": [
            {
              "toast": "{{ t('showcase_tasks.opened', 'You opened “{title}”', {'title': row.title}) }}"
            }
          ]
        },
        {
          "id": "live-row",
          "type": "box",
          "direction": "row",
          "components": [
            {
              "id": "live-explain",
              "type": "text",
              "text": "{{ t('showcase_tasks.the_boards_listen_to_the_stream_', 'The boards listen to the event stream of the tasks: when someone else moves a card, they read the tasks again by themselves.') }}",
              "grow": 1
            },
            {
              "id": "btn-colleague",
              "type": "button",
              "label": "{{ t('showcase_tasks.a_colleague_moves_a_card', 'A colleague moves a card') }}",
              "onClick": [
                {
                  "call": "colleagueMove"
                },
                {
                  "toast": "{{ t('showcase_tasks.watch_the_board', 'Watch the board: the change arrives in a moment.') }}"
                }
              ]
            }
          ]
        },
        {
          "id": "lanes-title",
          "type": "text",
          "style": "heading",
          "text": "{{ t('showcase_tasks.board_in_lanes', 'The same tasks in swimlanes') }}"
        },
        {
          "id": "group-by",
          "type": "input",
          "field": {
            "name": "groupBy",
            "type": "select",
            "label": "{{ t('showcase_tasks.group_by', 'Group by') }}",
            "options": [
              "who",
              "priority"
            ],
            "optionKey": "showcase_tasks.group_by"
          },
          "default": "who"
        },
        {
          "id": "kanban-lanes",
          "type": "kanban",
          "source": "tasks",
          "columnField": "status",
          "titleField": "title",
          "laneField": "{{ state.groupBy }}",
          "moveAcrossLanes": true,
          "badges": [
            {
              "field": "priority",
              "tones": {
                "high": "danger",
                "normal": "primary"
              },
              "valueKey": "values.priority"
            }
          ],
          "columnsFrom": {
            "source": "statuses",
            "valueField": "id",
            "labelField": "name",
            "toneField": "tone",
            "limitField": "wip"
          },
          "moveIf": "{{ can('showcase.components.read') }}",
          "onMove": [
            {
              "if": "{{ lane != fromLane }}",
              "then": {
                "confirm": "{{ t('showcase_tasks.confirm_lane', 'Move “{title}” to {lane}?', {'title': row.title, 'lane': laneLabel}) }}"
              }
            },
            {
              "call": "moveTaskToLane",
              "args": {
                "id": "{{ row.id }}",
                "status": "{{ to }}",
                "beforeId": "{{ beforeId }}",
                "afterId": "{{ afterId }}",
                "field": "{{ state.groupBy }}",
                "lane": "{{ lane }}"
              },
              "onError": {
                "toast": "{{ t('showcase_tasks.move_failed', 'Move failed') }}"
              }
            },
            {
              "refresh": "tasks"
            },
            {
              "toast": "{{ t('showcase_tasks.moved', '“{title}” moved', {'title': row.title}) }}"
            }
          ],
          "lanes": "{{ state.groupBy == 'priority' ? [{'value': 'high', 'label': t('values.priority.high', 'High')}, {'value': 'normal', 'label': t('values.priority.normal', 'Normal')}, {'value': 'low', 'label': t('values.priority.low', 'Low')}] : [] }}"
        }
      ]
    },
    {
      "id": "section-status",
      "type": "section",
      "title": "{{ t('showcase_tasks.status_title', 'Status of a task: menu button') }}",
      "components": [
        {
          "id": "status-explain",
          "type": "text",
          "text": "{{ t('showcase_tasks.status_explain', 'The button shows the status of “{title}”. Its menu lists the transitions the task can take, from a data source, each with the status it leads to.', {'title': has(data.task) ? data.task.title : ''}) }}"
        },
        {
          "id": "task-status",
          "type": "menuButton",
          "label": "{{ !has(data.task) ? '…' : data.task.status == 'done' ? t('values.taskStatus.done', 'Done') : data.task.status == 'in-progress' ? t('values.taskStatus.in-progress', 'In progress') : t('values.taskStatus.to-do', 'To do') }}",
          "tone": "{{ has(data.task) ? data.task.tone : 'neutral' }}",
          "items": [
            {
              "source": "taskMoves",
              "labelField": "name",
              "badgeField": "to",
              "toneField": "category",
              "tones": {
                "new": "neutral",
                "indeterminate": "primary",
                "done": "success"
              },
              "valueKey": "values.taskStatus",
              "enabledIf": "{{ can('showcase.components.read') }}",
              "onClick": [
                {
                  "call": "moveTask",
                  "args": {
                    "id": 1,
                    "status": "{{ item.to }}",
                    "beforeId": null,
                    "afterId": null
                  },
                  "onError": {
                    "toast": "{{ t('showcase_tasks.move_failed', 'Move failed') }}"
                  }
                },
                {
                  "refresh": "task"
                },
                {
                  "refresh": "taskMoves"
                },
                {
                  "refresh": "tasks"
                },
                {
                  "toast": "{{ t('showcase_tasks.status_moved', '“{transition}” done', {'transition': item.name}) }}"
                }
              ]
            },
            {
              "divider": true
            },
            {
              "id": "status-workflow",
              "label": "{{ t('showcase_tasks.status_workflow', 'View the workflow') }}",
              "icon": "eye",
              "onClick": [
                {
                  "view": {
                    "title": "{{ t('showcase_tasks.workflow_title', 'Workflow of “{title}”', {'title': has(data.task) ? data.task.title : ''}) }}",
                    "size": "large",
                    "components": [
                      {
                        "id": "workflow-graph",
                        "type": "graph",
                        "source": "taskWorkflow",
                        "nodes": {
                          "field": "statuses",
                          "valueKey": "values.taskStatus",
                          "toneField": "tone"
                        },
                        "edges": {
                          "field": "transitions",
                          "labelField": "name"
                        },
                        "highlight": "{{ has(data.task) ? data.task.status : '' }}",
                        "start": "to-do",
                        "height": 300,
                        "caption": "{{ t('showcase_tasks.workflow_caption', 'The statuses of the tasks and the transitions between them; the current status is outlined.') }}"
                      },
                      {
                        "id": "workflow-explain",
                        "type": "text",
                        "text": "{{ t('showcase_tasks.workflow_explain', 'The window reads the data sources of the screen: these are the transitions the task can take now.') }}"
                      },
                      {
                        "id": "workflow-moves",
                        "type": "table",
                        "source": "taskMoves",
                        "columns": [
                          {
                            "field": "name",
                            "label": "{{ t('showcase_tasks.workflow_transition', 'Transition') }}"
                          },
                          {
                            "field": "to",
                            "label": "{{ t('showcase_tasks.workflow_to', 'Leads to') }}",
                            "valueKey": "values.taskStatus"
                          }
                        ]
                      }
                    ]
                  }
                }
              ]
            },
            {
              "id": "status-board",
              "label": "{{ t('showcase_tasks.status_board', 'Show it on the board') }}",
              "icon": "eye",
              "onClick": [
                {
                  "toast": "{{ t('showcase_tasks.status_board_toast', 'It is the first card of the board above') }}"
                }
              ]
            }
          ]
        },
        {
          "id": "toolbar-explain",
          "type": "text",
          "text": "{{ t('showcase_tasks.toolbar_explain', 'Icon buttons, as at the top of an item: the eye counts the watchers and stays highlighted while you watch, the thumb counts the votes; «…» holds the other actions, among them the flag, which shows a red button while the task is flagged. Their text is what screen readers read and the tooltip.') }}"
        },
        {
          "id": "status-toolbar",
          "type": "box",
          "gap": "small",
          "components": [
            {
              "id": "task-flag",
              "type": "button",
              "label": "{{ t('showcase_tasks.flag_remove', 'Remove the flag') }}",
              "icon": "flag",
              "display": "icon",
              "tone": "danger",
              "pressed": "{{ has(state.flagged) && state.flagged }}",
              "visibleIf": "{{ has(state.flagged) && state.flagged }}",
              "onClick": [
                {
                  "set": {
                    "path": "state.flagged",
                    "value": false
                  }
                }
              ]
            },
            {
              "id": "task-watchers",
              "type": "menuButton",
              "label": "{{ t('showcase_tasks.watchers', 'Watchers') }}",
              "icon": "eye",
              "display": "icon",
              "count": "{{ has(state.watching) && state.watching ? 3 : 2 }}",
              "pressed": "{{ has(state.watching) && state.watching }}",
              "items": [
                {
                  "id": "watch-start",
                  "label": "{{ t('showcase_tasks.watch', 'Watch') }}",
                  "visibleIf": "{{ !(has(state.watching) && state.watching) }}",
                  "onClick": [
                    {
                      "set": {
                        "path": "state.watching",
                        "value": true
                      }
                    }
                  ]
                },
                {
                  "id": "watch-stop",
                  "label": "{{ t('showcase_tasks.watch_stop', 'Stop watching') }}",
                  "visibleIf": "{{ has(state.watching) && state.watching }}",
                  "onClick": [
                    {
                      "set": {
                        "path": "state.watching",
                        "value": false
                      }
                    }
                  ]
                }
              ]
            },
            {
              "id": "task-like",
              "type": "button",
              "label": "{{ t('showcase_tasks.votes', 'Votes') }}",
              "icon": "like",
              "display": "icon",
              "count": "{{ has(state.liked) && state.liked ? 5 : 4 }}",
              "pressed": "{{ has(state.liked) && state.liked }}",
              "onClick": [
                {
                  "set": {
                    "path": "state.liked",
                    "value": "{{ !(has(state.liked) && state.liked) }}"
                  }
                }
              ]
            },
            {
              "id": "task-copy-link",
              "type": "button",
              "label": "{{ t('showcase_tasks.copy_link', 'Copy the link') }}",
              "icon": "link",
              "display": "icon",
              "onClick": [
                {
                  "toast": "{{ t('showcase_tasks.link_copied', 'Link copied') }}"
                }
              ]
            },
            {
              "id": "task-more",
              "type": "menuButton",
              "label": "{{ t('showcase_tasks.more_actions', 'More actions') }}",
              "icon": "more",
              "display": "icon",
              "items": [
                {
                  "id": "task-flag-add",
                  "label": "{{ t('showcase_tasks.flag_add', 'Add flag') }}",
                  "icon": "flag",
                  "visibleIf": "{{ !(has(state.flagged) && state.flagged) }}",
                  "onClick": [
                    {
                      "set": {
                        "path": "state.flagged",
                        "value": true
                      }
                    },
                    {
                      "popover": {
                        "title": "{{ t('showcase_tasks.flag_added', 'Flag added') }}",
                        "icon": "flag",
                        "tone": "danger",
                        "fields": [
                          {
                            "name": "comment",
                            "type": "textarea",
                            "label": "{{ t('showcase_tasks.flag_why', 'Optional: let your team know why this task has been flagged') }}"
                          }
                        ],
                        "submitLabel": "{{ t('showcase_tasks.flag_comment_add', 'Add comment') }}",
                        "submitEnabledIf": "{{ isValid('required', form.comment) }}",
                        "onSubmit": [
                          {
                            "toast": "{{ t('showcase_tasks.flag_commented', 'Comment added (demo)') }}"
                          }
                        ]
                      }
                    }
                  ]
                },
                {
                  "id": "task-flag-remove",
                  "label": "{{ t('showcase_tasks.flag_remove', 'Remove the flag') }}",
                  "icon": "flag",
                  "visibleIf": "{{ has(state.flagged) && state.flagged }}",
                  "onClick": [
                    {
                      "set": {
                        "path": "state.flagged",
                        "value": false
                      }
                    }
                  ]
                },
                {
                  "divider": true
                },
                {
                  "id": "task-clone",
                  "label": "{{ t('showcase_tasks.clone', 'Clone') }}",
                  "icon": "copy",
                  "onClick": [
                    {
                      "toast": "{{ t('showcase_tasks.cloned', 'Cloned (demo)') }}"
                    }
                  ]
                },
                {
                  "divider": true
                },
                {
                  "id": "task-delete",
                  "label": "{{ t('showcase_tasks.delete', 'Delete') }}",
                  "icon": "delete",
                  "tone": "danger",
                  "onClick": [
                    {
                      "confirm": "{{ t('showcase_tasks.delete_confirm', 'Delete the task? (demo: nothing is deleted)') }}"
                    },
                    {
                      "toast": "{{ t('showcase_tasks.deleted', 'Deleted (demo)') }}"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "section-comments",
      "type": "section",
      "title": "{{ t('showcase_tasks.comments', 'Comments') }}",
      "components": [
        {
          "id": "explain-comments",
          "type": "text",
          "text": "{{ t('showcase_tasks.the_thread_of_the_team_in_date_o', 'The thread of the team in date order. Write in Markdown, type @ followed by a name to mention a person, Ctrl+Enter or «Publish» to send. Your own comments can be changed and deleted.') }}"
        },
        {
          "id": "comments",
          "type": "comments",
          "source": "comments",
          "onPost": [
            {
              "call": "addComment"
            },
            {
              "refresh": "comments"
            }
          ],
          "postIf": "{{ can('showcase.components.read') }}",
          "onEdit": [
            {
              "call": "updateComment",
              "args": {
                "id": "{{ row.id }}"
              }
            },
            {
              "refresh": "comments"
            }
          ],
          "editIf": "{{ row._perm.update }}",
          "onDelete": [
            {
              "confirm": "{{ t('showcase_tasks.delete_the_comment', 'Delete the comment?') }}"
            },
            {
              "call": "deleteComment",
              "args": {
                "id": "{{ row.id }}"
              }
            },
            {
              "refresh": "comments"
            }
          ],
          "deleteIf": "{{ row._perm.delete }}",
          "editedField": "editedAt",
          "mentions": {
            "source": "people",
            "valueField": "id",
            "labelField": "name"
          }
        }
      ]
    },
    {
      "id": "section-events",
      "type": "section",
      "title": "{{ t('showcase_tasks.history_of_order_1001', 'History of order 1001') }}",
      "components": [
        {
          "id": "timeline",
          "type": "timeline",
          "source": "events",
          "dateField": "date",
          "labelField": "title",
          "descriptionField": "note",
          "toneField": "outcome",
          "tones": {
            "ok": "success",
            "ko": "danger"
          },
          "withTime": true
        },
        {
          "id": "links",
          "type": "box",
          "gap": "large",
          "components": [
            {
              "id": "link-order",
              "type": "link",
              "label": "{{ t('showcase_tasks.open_order_1001', 'Open order 1001') }}",
              "screen": "order-detail",
              "params": {
                "id": 1001
              }
            },
            {
              "id": "link-external",
              "type": "link",
              "label": "{{ t('showcase_tasks.ng_zorro_documentation', 'NG-ZORRO documentation') }}",
              "href": "https://ng.ant.design/"
            }
          ]
        }
      ]
    }
  ]
}
