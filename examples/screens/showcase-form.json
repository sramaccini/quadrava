{
  "schemaVersion": "1.0",
  "screen": "showcase-form",
  "title": "{{ t('showcase_form.showcase_forms', 'Showcase: forms') }}",
  "requires": "showcase.components.read",
  "dataSources": {
    "save": {
      "ref": "showcase-form/save"
    },
    "order": {
      "ref": "showcase-form/order"
    },
    "saveOrder": {
      "ref": "showcase-form/saveOrder"
    },
    "ticket": {
      "ref": "showcase-form/ticket"
    },
    "saveTicket": {
      "ref": "showcase-form/saveTicket"
    },
    "customFields": {
      "ref": "showcase-form/customFields"
    },
    "people": {
      "ref": "showcase-form/people"
    },
    "workItem": {
      "ref": "showcase-form/workItem"
    },
    "patchWorkItem": {
      "ref": "showcase-form/patchWorkItem"
    }
  },
  "components": [
    {
      "id": "title",
      "type": "text",
      "style": "heading",
      "text": "{{ t('showcase_form.forms', 'Forms') }}"
    },
    {
      "id": "intro",
      "type": "text",
      "text": "{{ t('showcase_form.all_field_types_required_fields', 'All field types, required fields, rule-based validation, and fields that appear, lock or disappear according to values and permissions.') }}"
    },
    {
      "id": "section-entry",
      "type": "section",
      "title": "{{ t('showcase_form.entry_form_all_field_types', 'Entry form: all field types') }}",
      "components": [
        {
          "id": "form-types",
          "type": "form",
          "initial": {
            "category": "private",
            "newsletter": true
          },
          "fields": [
            {
              "name": "name",
              "type": "text",
              "label": "{{ t('common.name', 'Name') }}",
              "required": true
            },
            {
              "name": "age",
              "type": "number",
              "label": "{{ t('showcase_form.age', 'Age') }}",
              "validate": {
                "rule": "{{value >= 18 && value <= 120}}",
                "message": "{{ t('showcase_form.age_must_be_between_18_and_120', 'Age must be between 18 and 120') }}"
              }
            },
            {
              "name": "category",
              "type": "select",
              "label": "{{ t('showcase_form.category', 'Category') }}",
              "options": [
                "private",
                "business"
              ],
              "required": true,
              "optionKey": "values.type"
            },
            {
              "name": "vatNumber",
              "type": "text",
              "label": "{{ t('showcase_form.vat_number_business_only', 'VAT number (business only)') }}",
              "visibleIf": "{{form.category == 'business'}}",
              "required": true,
              "validate": {
                "rule": "{{size(string(value)) == 11}}",
                "message": "{{ t('showcase_form.the_vat_number_has_11_digits', 'The VAT number has 11 digits') }}"
              }
            },
            {
              "name": "birth",
              "type": "date",
              "label": "{{ t('showcase_form.date_of_birth', 'Date of birth') }}"
            },
            {
              "name": "newsletter",
              "type": "checkbox",
              "label": "{{ t('showcase_form.i_want_to_receive_the_newsletter', 'I want to receive the newsletter') }}"
            },
            {
              "name": "taxCode",
              "type": "text",
              "label": "{{ t('showcase_form.tax_code_sensitive_data', 'Tax code (sensitive data)') }}",
              "sensitive": true
            }
          ],
          "actions": [
            {
              "id": "btn-send",
              "label": "{{ t('showcase_form.submit', 'Submit') }}",
              "onClick": [
                {
                  "call": "save",
                  "onError": {
                    "toast": "{{ t('showcase_form.submission_failed', 'Submission failed') }}"
                  }
                },
                {
                  "toast": "{{ t('showcase_form.data_submitted', 'Data submitted') }}"
                }
              ]
            },
            {
              "id": "btn-reset",
              "label": "{{ t('showcase_form.what_do_actions_receive', 'What do actions receive?') }}",
              "onClick": [
                {
                  "toast": "{{ t('showcase_form.a_form_s_actions_receive_the_val', 'A form\\'s actions receive the values in \\'form\\'') }}"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "section-edit",
      "type": "section",
      "title": "{{ t('showcase_form.edit_form_data_from_the_service', 'Edit form: data from the service, fields and actions according to permissions') }}",
      "components": [
        {
          "id": "order-form",
          "type": "form",
          "source": "order",
          "fields": [
            {
              "name": "customer",
              "label": "{{ t('common.customer', 'Customer') }}",
              "type": "text",
              "required": true
            },
            {
              "name": "type",
              "label": "{{ t('common.type', 'Type') }}",
              "type": "select",
              "options": [
                "private",
                "business"
              ],
              "optionKey": "values.type"
            },
            {
              "name": "discount",
              "label": "{{ t('common.discount', 'Discount') }}",
              "type": "number",
              "visibleIf": "{{form.type == 'business'}}",
              "validate": {
                "rule": "{{value <= 20}}",
                "message": "{{ t('common.maximum_discount_is_20', 'Maximum discount is 20%') }}"
              }
            },
            {
              "name": "iban",
              "label": "{{ t('showcase_layout.iban', 'IBAN') }}",
              "type": "text",
              "sensitive": true,
              "hiddenIf": "{{!can('orders.iban.read')}}",
              "readOnlyIf": "{{!can('orders.iban.write')}}"
            }
          ],
          "actions": [
            {
              "id": "btn-save",
              "label": "{{ t('common.save', 'Save') }}",
              "enabledIf": "{{can('orders.order.write') && form._perm.update}}",
              "onClick": [
                {
                  "call": "saveOrder",
                  "onError": {
                    "toast": "{{ t('common.saving_failed', 'Saving failed') }}"
                  }
                },
                {
                  "toast": "{{ t('showcase_form.order_saved', 'Order saved') }}"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "section-custom",
      "type": "section",
      "title": "{{ t('showcase_form.fields_from_the_service', 'Fields from the service: the custom fields of a project') }}",
      "components": [
        {
          "id": "custom-intro",
          "type": "text",
          "text": "{{ t('showcase_form.fields_from_the_service_intro', 'The fields after the title come from a data source (fieldsFrom): their labels and options are data, shown as they are. The values travel in the custom object, and the service checks them again.') }}"
        },
        {
          "id": "ticket-form",
          "type": "form",
          "source": "ticket",
          "fields": [
            {
              "name": "title",
              "label": "{{ t('showcase_form.title', 'Title') }}",
              "type": "text",
              "required": true
            }
          ],
          "fieldsFrom": {
            "source": "customFields",
            "into": "custom",
            "nameField": "key",
            "types": {
              "user": {
                "name": "user",
                "type": "lookup",
                "lookup": {
                  "source": "people",
                  "valueField": "id",
                  "labelField": "name",
                  "minChars": 0
                }
              }
            }
          },
          "actions": [
            {
              "id": "btn-save-ticket",
              "label": "{{ t('common.save', 'Save') }}",
              "onClick": [
                {
                  "call": "saveTicket",
                  "onError": {
                    "toast": "{{ t('common.saving_failed', 'Saving failed') }}"
                  }
                },
                {
                  "toast": "{{ t('showcase_form.ticket_saved', 'Ticket saved') }}"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "section-widths",
      "type": "section",
      "title": "{{ t('showcase_form.widths_title', 'Field widths and flow layout') }}",
      "components": [
        {
          "id": "widths-intro",
          "type": "text",
          "text": "{{ t('showcase_form.widths_intro', 'Each field says how wide it is (width: xs, s, m, l, full) and, with layout flow, the fields sit side by side while they fit; a field without width takes a whole line, the description with width full all of it.') }}"
        },
        {
          "id": "widths-form",
          "type": "form",
          "layout": "flow",
          "fields": [
            {
              "name": "code",
              "type": "text",
              "label": "{{ t('showcase_form.widths_code', 'Code') }}",
              "width": "xs"
            },
            {
              "name": "issueDate",
              "type": "date",
              "label": "{{ t('showcase_form.widths_issue_date', 'Issue date') }}",
              "width": "s"
            },
            {
              "name": "amount",
              "type": "number",
              "label": "{{ t('showcase_form.widths_amount', 'Amount') }}",
              "width": "s"
            },
            {
              "name": "status",
              "type": "select",
              "label": "{{ t('showcase_form.widths_status', 'Status (set by the workflow)') }}",
              "options": [
                "draft",
                "sent",
                "paid"
              ],
              "optionKey": "values.status",
              "readOnlyIf": "{{ true }}",
              "width": "s"
            },
            {
              "name": "sentOn",
              "type": "date",
              "label": "{{ t('showcase_form.widths_sent_on', 'Sent on') }}",
              "readOnlyIf": "{{ true }}",
              "width": "s"
            },
            {
              "name": "channels",
              "type": "multiselect",
              "label": "{{ t('showcase_form.widths_channels', 'Sent by') }}",
              "options": [
                "*",
                "email",
                "post"
              ],
              "optionKey": "values.channel",
              "readOnlyIf": "{{ true }}",
              "width": "m",
              "optionKeys": {
                "*": "values.channel.any"
              }
            },
            {
              "name": "customer",
              "type": "text",
              "label": "{{ t('showcase_form.widths_customer', 'Customer') }}",
              "width": "m"
            },
            {
              "name": "street",
              "type": "text",
              "label": "{{ t('showcase_form.widths_street', 'Street') }}",
              "width": "l"
            },
            {
              "name": "postcode",
              "type": "text",
              "label": "{{ t('showcase_form.widths_postcode', 'Postcode') }}",
              "width": "xs"
            },
            {
              "name": "town",
              "type": "text",
              "label": "{{ t('showcase_form.widths_town', 'Town') }}",
              "width": "m"
            },
            {
              "name": "description",
              "type": "textarea",
              "label": "{{ t('showcase_form.widths_description', 'Description') }}",
              "width": "full"
            }
          ],
          "actions": [
            {
              "id": "btn-widths-save",
              "label": "{{ t('showcase_form.widths_save', 'Save') }}",
              "icon": "save",
              "onClick": [
                {
                  "toast": "{{ t('showcase_form.widths_done', 'Only an example: nothing is sent') }}"
                }
              ]
            },
            {
              "id": "btn-widths-save-draft",
              "label": "{{ t('showcase_form.widths_save_draft', 'Save as draft') }}",
              "onClick": [
                {
                  "toast": "{{ t('showcase_form.widths_done', 'Only an example: nothing is sent') }}"
                }
              ]
            },
            {
              "id": "btn-widths-send",
              "label": "{{ t('showcase_form.widths_send', 'Save and send for approval') }}",
              "onClick": [
                {
                  "toast": "{{ t('showcase_form.widths_done', 'Only an example: nothing is sent') }}"
                }
              ]
            },
            {
              "id": "btn-widths-discard",
              "label": "{{ t('showcase_form.widths_discard', 'Discard changes') }}",
              "onClick": [
                {
                  "toast": "{{ t('showcase_form.widths_done', 'Only an example: nothing is sent') }}"
                }
              ]
            }
          ],
          "initial": {
            "status": "sent",
            "sentOn": "2026-11-02",
            "channels": [
              "*"
            ]
          }
        }
      ]
    },
    {
      "id": "section-inline",
      "type": "section",
      "title": "{{ t('showcase_form.inline_title', 'Inline editing') }}",
      "components": [
        {
          "id": "inline-intro",
          "type": "text",
          "text": "{{ t('showcase_form.inline_intro', 'With edit inline each field shows its value as text, like the summary and description of a work item: click it (or focus it and press Enter) to open only that field. Enter or ✓ confirms a single line, Ctrl+Enter or Save the description, choosing a value confirms the assignee and the priority; Escape or Cancel puts the value back. The checkbox saves at every click. Every confirmation sends only that field.') }}"
        },
        {
          "id": "inline-share",
          "type": "box",
          "justify": "end",
          "components": [
            {
              "id": "inline-copy-link",
              "type": "button",
              "label": "{{ t('showcase_form.copy_link', 'Copy link') }}",
              "icon": "link",
              "tone": "neutral",
              "onClick": [
                {
                  "copyLink": {},
                  "copied": "{{ t('showcase_form.link_copied', 'Link copied') }}"
                }
              ]
            },
            {
              "id": "inline-more",
              "type": "menuButton",
              "label": "{{ t('showcase_form.more_actions', 'More actions') }}",
              "icon": "more",
              "display": "icon",
              "items": [
                {
                  "id": "inline-more-link",
                  "label": "{{ t('showcase_form.copy_link', 'Copy link') }}",
                  "onClick": [
                    {
                      "copyLink": {},
                      "copied": "{{ t('showcase_form.link_copied', 'Link copied') }}"
                    }
                  ]
                },
                {
                  "id": "inline-more-key",
                  "label": "{{ t('showcase_form.copy_key', 'Copy key') }}",
                  "onClick": [
                    {
                      "copy": "ODT-42",
                      "copied": "{{ t('showcase_form.key_copied', 'Key copied') }}"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "inline-form",
          "type": "form",
          "source": "workItem",
          "edit": "inline",
          "fields": [
            {
              "name": "summary",
              "type": "text",
              "label": "{{ t('showcase_form.inline_summary', 'Summary') }}",
              "display": "heading",
              "required": true,
              "maxLength": 120
            },
            {
              "name": "description",
              "type": "richtext",
              "label": "{{ t('showcase_form.inline_description', 'Description') }}",
              "emptyText": "{{ t('showcase_form.inline_description_empty', 'Add a description…') }}"
            },
            {
              "name": "assignee",
              "type": "lookup",
              "label": "{{ t('showcase_form.inline_assignee', 'Assignee') }}",
              "emptyText": "{{ t('showcase_form.inline_unassigned', 'Unassigned') }}",
              "lookup": {
                "source": "people",
                "valueField": "id",
                "labelField": "name",
                "minChars": 0
              },
              "width": "m"
            },
            {
              "name": "priority",
              "type": "select",
              "label": "{{ t('showcase_form.inline_priority', 'Priority') }}",
              "options": [
                "low",
                "medium",
                "high"
              ],
              "optionKey": "showcase_form.priority",
              "width": "s"
            },
            {
              "name": "dueDate",
              "type": "date",
              "label": "{{ t('showcase_form.inline_due', 'Due date') }}",
              "width": "s"
            },
            {
              "name": "key",
              "type": "text",
              "label": "{{ t('showcase_form.inline_key', 'Key') }}",
              "readOnlyIf": "{{ true }}",
              "width": "s"
            },
            {
              "name": "blocked",
              "type": "checkbox",
              "label": "{{ t('showcase_form.inline_blocked', 'Blocked by another item') }}"
            }
          ],
          "onSave": [
            {
              "call": "patchWorkItem"
            },
            {
              "refresh": "workItem"
            },
            {
              "toast": "{{ t('showcase_form.inline_saved', 'Saved: {field}', {'field': field}) }}"
            }
          ]
        }
      ]
    }
  ]
}
