{
  "schemaVersion": "1.0",
  "screen": "ordini-elenco",
  "title": "{{ t('ordini_elenco.ordini', 'Ordini') }}",
  "description": "{{ t('ordini_elenco.ordini_con_azioni_di_riga_second', 'Ordini con azioni di riga secondo i permessi.') }}",
  "requires": "ordini.ordine.leggi",
  "dataSources": {
    "ordini": {
      "type": "rest",
      "method": "GET",
      "url": "/api/ordini",
      "params": {
        "stato": "{{state.filtri.stato}}",
        "page": "{{state.page}}"
      },
      "paging": "server"
    },
    "approvaOrdine": {
      "type": "rest",
      "method": "POST",
      "url": "/api/ordini/{{id}}/approva"
    }
  },
  "components": [
    {
      "id": "filtri-ordini",
      "type": "filterBar",
      "bind": "state.filtri",
      "fields": [
        {
          "name": "stato",
          "type": "select",
          "label": "{{ t('comune.stato', 'Stato') }}",
          "options": [
            "bozza",
            "inviato",
            "approvato"
          ],
          "optionKey": "valori.stato"
        }
      ]
    },
    {
      "id": "tabella-ordini",
      "type": "table",
      "source": "ordini",
      "columns": [
        {
          "field": "numero",
          "label": "{{ t('comune.numero', 'Numero') }}"
        },
        {
          "field": "cliente",
          "label": "{{ t('comune.cliente', 'Cliente') }}"
        },
        {
          "field": "stato",
          "label": "{{ t('comune.stato', 'Stato') }}",
          "valueKey": "valori.stato"
        }
      ],
      "rowActions": [
        {
          "id": "btn-apri",
          "label": "{{ t('comune.apri', 'Apri') }}",
          "onClick": [
            {
              "navigate": "ordine-dettaglio",
              "params": {
                "id": "{{row.id}}"
              }
            }
          ]
        },
        {
          "id": "btn-approva",
          "label": "{{ t('comune.approva', 'Approva') }}",
          "visibleIf": "{{can('ordini.ordine.approva') && row.stato == 'inviato'}}",
          "onClick": [
            {
              "call": "approvaOrdine",
              "args": {
                "id": "{{row.id}}"
              },
              "onError": {
                "toast": "{{ t('comune.approvazione_non_riuscita', 'Approvazione non riuscita') }}"
              }
            },
            {
              "refresh": "ordini"
            },
            {
              "toast": "{{ t('comune.ordine_approvato', 'Ordine approvato') }}"
            }
          ]
        }
      ]
    }
  ]
}
