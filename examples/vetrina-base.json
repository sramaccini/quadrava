{
  "schemaVersion": "1.0",
  "screen": "vetrina-base",
  "title": "{{ t('vetrina_base.vetrina_componenti_base', 'Vetrina: componenti base') }}",
  "requires": "vetrina.componenti.leggi",
  "dataSources": {
    "segnala": {
      "type": "rest",
      "method": "POST",
      "url": "/api/vetrina/segnala",
      "body": {
        "messaggio": "{{state.messaggio}}"
      }
    },
    "segnalaConErrore": {
      "type": "rest",
      "method": "POST",
      "url": "/api/vetrina/errore"
    }
  },
  "components": [
    {
      "id": "titolo",
      "type": "text",
      "style": "heading",
      "text": "{{ t('vetrina_base.componenti_base', 'Componenti base') }}"
    },
    {
      "id": "intro",
      "type": "text",
      "tooltip": "{{ t('vetrina_base.ogni_componente_puo_avere_un_too', 'Ogni componente può avere un tooltip opzionale (solo testo, anche con espressioni)') }}",
      "text": "{{ t('vetrina_base.questa_schermata_mostra_testo_se', 'Questa schermata mostra testo, sezioni e pulsanti con le cinque azioni disponibili: set, call, refresh, navigate e toast.') }}"
    },
    {
      "id": "sezione-testo",
      "type": "section",
      "title": "{{ t('vetrina_base.testo_con_valori_dinamici', 'Testo con valori dinamici') }}",
      "components": [
        {
          "id": "saluto",
          "type": "text",
          "text": "{{ t('vetrina_base.utente_collegato', 'Utente collegato: {username}', {'username': dyn(user.username)}) }}"
        },
        {
          "id": "contatore-testo",
          "type": "text",
          "text": "{{ t('vetrina_base.hai_premuto_il_pulsante_volte', 'Hai premuto il pulsante {contatore} volte.', {'contatore': dyn(has(state.contatore) ? state.contatore : 0)}) }}"
        }
      ]
    },
    {
      "id": "sezione-lingue",
      "type": "section",
      "title": "{{ t('vetrina.lingue.titolo', 'Lingue e traduzioni') }}",
      "components": [
        {
          "id": "lingue-intro",
          "type": "text",
          "text": "{{ t('vetrina.lingue.intro', 'Cambia la lingua dal selettore in alto') }}"
        },
        {
          "id": "lingue-attiva",
          "type": "text",
          "text": "{{ t('vetrina.lingue.attiva', 'Lingua attiva: {lingua}', {'lingua': user.locale}) }}"
        },
        {
          "id": "lingue-importo",
          "type": "text",
          "text": "{{ t('vetrina.lingue.importo', 'Importo: {v}', {'v': fmtCurrency(1234.5, 'EUR')}) }}"
        },
        {
          "id": "lingue-data",
          "type": "text",
          "text": "{{ t('vetrina.lingue.data', 'Data: {v}', {'v': fmtDate('2026-10-09')}) }}"
        },
        {
          "id": "lingue-righe",
          "type": "text",
          "text": "{{ t('vetrina.lingue.righe', '{n} registrate', {'n': has(state.contatore) ? state.contatore : 0}) }}"
        },
        {
          "id": "lingue-bottone",
          "type": "button",
          "label": "{{ t('vetrina.lingue.bottone', 'Pulsante con tooltip tradotto') }}",
          "tooltip": "{{ t('vetrina.lingue.tooltip', 'Questo tooltip cambia con la lingua') }}",
          "onClick": [
            {
              "toast": "{{ t('vetrina.lingue.toast', 'Ciao {nome}!', {'nome': user.username}) }}"
            }
          ]
        }
      ]
    },
    {
      "id": "sezione-azioni",
      "type": "section",
      "title": "{{ t('vetrina_base.pulsanti_e_azioni', 'Pulsanti e azioni') }}",
      "components": [
        {
          "id": "btn-incrementa",
          "type": "button",
          "label": "{{ t('vetrina_base.incrementa_il_contatore_set', 'Incrementa il contatore (set)') }}",
          "tooltip": "{{ t('vetrina_base.il_contatore_vale_ogni_clic_lo_a', 'Il contatore vale {contatore}: ogni clic lo aumenta di uno', {'contatore': dyn(has(state.contatore) ? state.contatore : 0)}) }}",
          "onClick": [
            {
              "set": {
                "path": "contatore",
                "value": "{{has(state.contatore) ? state.contatore + 1 : 1}}"
              }
            }
          ]
        },
        {
          "id": "btn-toast",
          "type": "button",
          "label": "{{ t('vetrina_base.mostra_un_messaggio_toast', 'Mostra un messaggio (toast)') }}",
          "onClick": [
            {
              "toast": "{{ t('vetrina_base.questo_e_un_messaggio_informativ', 'Questo è un messaggio informativo') }}"
            }
          ]
        },
        {
          "id": "btn-chiamata",
          "type": "button",
          "label": "{{ t('vetrina_base.chiama_un_servizio_call', 'Chiama un servizio (call)') }}",
          "onClick": [
            {
              "set": {
                "path": "messaggio",
                "value": "Ciao dalla vetrina"
              }
            },
            {
              "call": "segnala",
              "onError": {
                "toast": "{{ t('vetrina_base.chiamata_non_riuscita', 'Chiamata non riuscita') }}"
              }
            },
            {
              "toast": "{{ t('vetrina_base.servizio_chiamato', 'Servizio chiamato') }}"
            }
          ]
        },
        {
          "id": "btn-errore",
          "type": "button",
          "label": "{{ t('vetrina_base.chiamata_che_fallisce_onerror', 'Chiamata che fallisce (onError)') }}",
          "onClick": [
            {
              "call": "segnalaConErrore",
              "onError": {
                "toast": "{{ t('vetrina_base.errore_gestito_la_sequenza_si_fe', 'Errore gestito: la sequenza si ferma qui') }}"
              }
            },
            {
              "toast": "{{ t('vetrina_base.questo_messaggio_non_compare_mai', 'Questo messaggio non compare mai') }}"
            }
          ]
        },
        {
          "id": "btn-naviga",
          "type": "button",
          "label": "{{ t('vetrina_base.vai_alla_vetrina_delle_tabelle_n', 'Vai alla vetrina delle tabelle (navigate)') }}",
          "onClick": [
            {
              "navigate": "vetrina-tabelle",
              "params": {
                "evidenzia": "inviato"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "sezione-condizioni",
      "type": "section",
      "title": "{{ t('vetrina_base.visibilita_e_abilitazione', 'Visibilità e abilitazione') }}",
      "components": [
        {
          "id": "txt-condizioni",
          "type": "text",
          "text": "{{ t('vetrina_base.i_pulsanti_seguenti_cambiano_con', 'I pulsanti seguenti cambiano con i permessi dell\\'utente: provali con i tre profili del selettore in alto.') }}"
        },
        {
          "id": "btn-solo-responsabile",
          "type": "button",
          "label": "{{ t('vetrina_base.visibile_solo_con_il_permesso_di', 'Visibile solo con il permesso di approvare ordini') }}",
          "visibleIf": "{{can('ordini.ordine.approva')}}",
          "onClick": [
            {
              "toast": "{{ t('vetrina_base.hai_il_permesso_ordini_ordine_ap', 'Hai il permesso ordini.ordine.approva') }}"
            }
          ]
        },
        {
          "id": "btn-nascosto-admin",
          "type": "button",
          "label": "{{ t('vetrina_base.nascosto_a_chi_puo_leggere_gli_i', 'Nascosto a chi può leggere gli IBAN') }}",
          "hiddenIf": "{{can('ordini.iban.leggi')}}",
          "onClick": [
            {
              "toast": "{{ t('vetrina_base.non_vedi_gli_iban', 'Non vedi gli IBAN') }}"
            }
          ]
        },
        {
          "id": "btn-abilitato",
          "type": "button",
          "label": "{{ t('vetrina_base.abilitato_dopo_almeno_due_increm', 'Abilitato dopo almeno due incrementi') }}",
          "enabledIf": "{{has(state.contatore) && state.contatore >= 2}}",
          "onClick": [
            {
              "toast": "{{ t('vetrina_base.abilitato_dallo_stato_della_sche', 'Abilitato dallo stato della schermata') }}"
            }
          ]
        }
      ]
    }
  ]
}
