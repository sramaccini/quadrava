{
  "schemaVersion": "1.0",
  "screen": "vetrina-tabelle-avanzate",
  "title": "{{ t('vetrina_avanzate.titolo', 'Vetrina: tabelle avanzate') }}",
  "description": "{{ t('vetrina_avanzate.descrizione', 'Ordinamento, selezione, menu delle azioni, righe espandibili e totali.') }}",
  "requires": "vetrina.componenti.leggi",
  "dataSources": {
    "ordini": {
      "type": "rest",
      "method": "GET",
      "url": "/api/ordini",
      "params": {
        "sort": "{{state.ordinamento.field}}",
        "dir": "{{state.ordinamento.direction}}",
        "page": "{{state.page}}"
      },
      "paging": "server"
    },
    "fatture": {
      "type": "rest",
      "method": "GET",
      "url": "/api/fatture"
    },
    "inviaFatture": {
      "type": "rest",
      "method": "POST",
      "url": "/api/fatture/invia",
      "body": {
        "ids": "{{ids}}"
      }
    },
    "inviaFattura": {
      "type": "rest",
      "method": "POST",
      "url": "/api/fatture/{{id}}/invia"
    }
  },
  "components": [
    {
      "id": "titolo",
      "type": "text",
      "style": "heading",
      "text": "{{ t('vetrina_avanzate.intestazione', 'Tabelle avanzate') }}"
    },
    {
      "id": "sezione-ordinamento",
      "type": "section",
      "title": "{{ t('vetrina_avanzate.ordinamento', 'Ordinamento') }}",
      "components": [
        {
          "id": "spiega-ordinamento-server",
          "type": "text",
          "text": "{{ t('vetrina_avanzate.ordinamento_server', 'Ordini con paginazione lato server: l’ordinamento lo fa il servizio, che lo riceve dallo stato della schermata. All’apertura sono ordinati per numero decrescente.') }}"
        },
        {
          "id": "ordini-ordinati",
          "type": "table",
          "source": "ordini",
          "sort": {
            "bind": "state.ordinamento",
            "default": {
              "field": "numero",
              "direction": "desc"
            }
          },
          "columns": [
            {
              "field": "numero",
              "label": "{{ t('comune.numero', 'Numero') }}",
              "sortable": true
            },
            {
              "field": "cliente",
              "label": "{{ t('comune.cliente', 'Cliente') }}",
              "sortable": true
            },
            {
              "field": "sconto",
              "label": "{{ t('comune.sconto', 'Sconto') }}",
              "format": "percent",
              "sortable": true
            },
            {
              "field": "stato",
              "label": "{{ t('comune.stato', 'Stato') }}",
              "format": "badge",
              "badges": {
                "bozza": "neutral",
                "inviato": "primary",
                "approvato": "success"
              },
              "valueKey": "valori.stato"
            }
          ]
        },
        {
          "id": "spiega-ordinamento-pagina",
          "type": "text",
          "text": "{{ t('vetrina_avanzate.ordinamento_pagina', 'Fatture senza paginazione lato server: l’ordinamento avviene in pagina, sulle righe già caricate, senza nuove richieste.') }}"
        },
        {
          "id": "fatture-ordinate",
          "type": "table",
          "source": "fatture",
          "columns": [
            {
              "field": "numero",
              "label": "{{ t('comune.numero', 'Numero') }}",
              "sortable": true
            },
            {
              "field": "cliente",
              "label": "{{ t('comune.cliente', 'Cliente') }}",
              "sortable": true
            },
            {
              "field": "emessa",
              "label": "{{ t('comune.emessa_il', 'Emessa il') }}",
              "format": "date",
              "sortable": true
            },
            {
              "field": "importo",
              "label": "{{ t('comune.importo', 'Importo') }}",
              "format": "currency",
              "sortable": true
            }
          ]
        }
      ]
    },
    {
      "id": "sezione-selezione",
      "type": "section",
      "title": "{{ t('vetrina_avanzate.selezione', 'Selezione e azioni multiple') }}",
      "components": [
        {
          "id": "spiega-selezione",
          "type": "text",
          "text": "{{ t('vetrina_avanzate.selezione_spiega', 'Scegli le fatture con le caselle. «Invia le selezionate» si abilita solo se tutte le righe scelte sono bozze.') }}"
        },
        {
          "id": "fatture-selezionabili",
          "type": "table",
          "source": "fatture",
          "selection": {
            "bind": "state.fattureScelte"
          },
          "columns": [
            {
              "field": "numero",
              "label": "{{ t('comune.numero', 'Numero') }}"
            },
            {
              "field": "cliente",
              "label": "{{ t('comune.cliente', 'Cliente') }}"
            },
            {
              "field": "stato",
              "label": "{{ t('comune.stato', 'Stato') }}",
              "format": "badge",
              "badges": {
                "bozza": "neutral",
                "inviata": "primary",
                "pagata": "success"
              },
              "valueKey": "valori.stato"
            }
          ],
          "bulkActions": [
            {
              "id": "btn-invia-selezionate",
              "label": "{{ t('vetrina_avanzate.invia_selezionate', 'Invia le selezionate') }}",
              "tooltip": "{{ t('vetrina_avanzate.invia_selezionate_aiuto', 'Solo le bozze si possono inviare') }}",
              "enabledIf": "{{ size(selection) > 0 && selection.all(r, r.stato == 'bozza') }}",
              "onClick": [
                {
                  "confirm": "{{ t('vetrina_avanzate.conferma_invio', 'Inviare {n, plural, one {# fattura} other {# fatture}}?', {'n': size(selection)}) }}"
                },
                {
                  "call": "inviaFatture",
                  "args": {
                    "ids": "{{ selection.map(r, r.id) }}"
                  }
                },
                {
                  "set": {
                    "path": "state.fattureScelte",
                    "value": []
                  }
                },
                {
                  "refresh": "fatture"
                },
                {
                  "toast": "{{ t('vetrina_avanzate.fatture_inviate', 'Fatture inviate') }}"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "sezione-menu-azioni",
      "type": "section",
      "title": "{{ t('vetrina_avanzate.menu_azioni', 'Menu delle azioni di riga') }}",
      "components": [
        {
          "id": "spiega-menu-azioni",
          "type": "text",
          "text": "{{ t('vetrina_avanzate.menu_azioni_spiega', 'Con rowActionsInline: 1 solo la prima azione visibile è un pulsante; le altre stanno nel menu «⋯». Le azioni non disponibili restano visibili ma disabilitate.') }}"
        },
        {
          "id": "fatture-con-menu",
          "type": "table",
          "source": "fatture",
          "rowActionsInline": 1,
          "columns": [
            {
              "field": "numero",
              "label": "{{ t('comune.numero', 'Numero') }}"
            },
            {
              "field": "cliente",
              "label": "{{ t('comune.cliente', 'Cliente') }}"
            },
            {
              "field": "stato",
              "label": "{{ t('comune.stato', 'Stato') }}",
              "format": "badge",
              "badges": {
                "bozza": "neutral",
                "inviata": "primary",
                "pagata": "success"
              },
              "valueKey": "valori.stato"
            }
          ],
          "rowActions": [
            {
              "id": "btn-invia",
              "label": "{{ t('vetrina_avanzate.invia', 'Invia') }}",
              "enabledIf": "{{ row.stato == 'bozza' }}",
              "onClick": [
                {
                  "call": "inviaFattura",
                  "args": {
                    "id": "{{row.id}}"
                  }
                },
                {
                  "refresh": "fatture"
                },
                {
                  "toast": "{{ t('vetrina_avanzate.fattura_inviata', 'Fattura {numero} inviata', {'numero': row.numero}) }}"
                }
              ]
            },
            {
              "id": "btn-duplica",
              "label": "{{ t('vetrina_avanzate.duplica', 'Duplica') }}",
              "onClick": [
                {
                  "toast": "{{ t('vetrina_avanzate.duplicata', 'Copia di {numero} creata (esempio)', {'numero': row.numero}) }}"
                }
              ]
            },
            {
              "id": "btn-sollecita",
              "label": "{{ t('vetrina_avanzate.sollecita', 'Sollecita il pagamento') }}",
              "tooltip": "{{ t('vetrina_avanzate.sollecita_aiuto', 'Solo per le fatture inviate e non pagate') }}",
              "enabledIf": "{{ row.stato == 'inviata' }}",
              "onClick": [
                {
                  "toast": "{{ t('vetrina_avanzate.sollecito_inviato', 'Sollecito inviato a {cliente}', {'cliente': row.cliente}) }}"
                }
              ]
            },
            {
              "id": "btn-annulla",
              "label": "{{ t('vetrina_avanzate.annulla_fattura', 'Annulla la fattura') }}",
              "visibleIf": "{{ row.stato == 'bozza' }}",
              "onClick": [
                {
                  "confirm": "{{ t('vetrina_avanzate.conferma_annulla', 'Annullare la fattura {numero}?', {'numero': row.numero}) }}"
                },
                {
                  "toast": "{{ t('vetrina_avanzate.annullata', 'Annullamento simulato') }}"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "sezione-espandibili",
      "type": "section",
      "title": "{{ t('vetrina_avanzate.espandibili', 'Righe di dettaglio espandibili') }}",
      "components": [
        {
          "id": "spiega-espandibili",
          "type": "text",
          "text": "{{ t('vetrina_avanzate.espandibili_spiega', 'Il pulsante a sinistra apre sotto la riga un’area con altri componenti, che vedono la riga come row. Gli ordini approvati non si espandono (expandIf).') }}"
        },
        {
          "id": "ordini-espandibili",
          "type": "table",
          "source": "ordini",
          "columns": [
            {
              "field": "numero",
              "label": "{{ t('comune.numero', 'Numero') }}"
            },
            {
              "field": "cliente",
              "label": "{{ t('comune.cliente', 'Cliente') }}"
            },
            {
              "field": "stato",
              "label": "{{ t('comune.stato', 'Stato') }}",
              "format": "badge",
              "badges": {
                "bozza": "neutral",
                "inviato": "primary",
                "approvato": "success"
              },
              "valueKey": "valori.stato"
            }
          ],
          "expand": {
            "expandIf": "{{ row.stato != 'approvato' }}",
            "components": [
              {
                "id": "riepilogo-ordine",
                "type": "text",
                "text": "{{ t('vetrina_avanzate.riepilogo_ordine', 'Cliente {cliente}, sconto {sconto} %.', {'cliente': row.cliente, 'sconto': row.sconto}) }}"
              },
              {
                "id": "avviso-bozza",
                "type": "alert",
                "kind": "info",
                "visibleIf": "{{ row.stato == 'bozza' }}",
                "text": "{{ t('vetrina_avanzate.ordine_in_bozza', 'Ordine in bozza: non ancora inviato al cliente.') }}"
              },
              {
                "id": "apri-ordine",
                "type": "button",
                "label": "{{ t('vetrina_avanzate.apri_ordine', 'Apri l’ordine') }}",
                "onClick": [
                  {
                    "navigate": "ordine-dettaglio",
                    "params": {
                      "id": "{{row.id}}"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "id": "sezione-totali",
      "type": "section",
      "title": "{{ t('vetrina_avanzate.totali', 'Numeri, collegamenti e totali') }}",
      "components": [
        {
          "id": "spiega-totali",
          "type": "text",
          "text": "{{ t('vetrina_avanzate.totali_spiega', 'Il numero della fattura è un collegamento (onClick sulla colonna). In fondo la riga dei totali: somma delle righe e degli importi, aliquota media e numero di clienti.') }}"
        },
        {
          "id": "fatture-totali",
          "type": "table",
          "source": "fatture",
          "columns": [
            {
              "field": "numero",
              "label": "{{ t('comune.numero', 'Numero') }}",
              "onClick": [
                {
                  "toast": "{{ t('vetrina_avanzate.aperta', 'Hai aperto la fattura {numero}', {'numero': row.numero}) }}"
                }
              ]
            },
            {
              "field": "cliente",
              "label": "{{ t('comune.cliente', 'Cliente') }}",
              "aggregate": "count"
            },
            {
              "field": "righe",
              "label": "{{ t('vetrina_avanzate.righe', 'Righe') }}",
              "format": "number",
              "decimals": 0,
              "aggregate": "sum"
            },
            {
              "field": "aliquota",
              "label": "{{ t('vetrina_avanzate.aliquota', 'Aliquota IVA') }}",
              "format": "percent",
              "aggregate": "avg"
            },
            {
              "field": "importo",
              "label": "{{ t('comune.importo', 'Importo') }}",
              "format": "currency",
              "aggregate": "sum"
            }
          ]
        }
      ]
    }
  ]
}
