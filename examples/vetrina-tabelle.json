{
  "schemaVersion": "1.0",
  "screen": "vetrina-tabelle",
  "title": "{{ t('vetrina_tabelle.vetrina_filtri_e_tabelle', 'Vetrina: filtri e tabelle') }}",
  "requires": "vetrina.componenti.leggi",
  "dataSources": {
    "ordini": {
      "type": "rest",
      "method": "GET",
      "url": "/api/ordini",
      "params": {
        "stato": "{{state.filtri.stato}}",
        "page": "{{state.page}}"
      },
      "paging": "server"
    },
    "approvaOrdine": {
      "type": "rest",
      "method": "POST",
      "url": "/api/ordini/{{id}}/approva"
    },
    "pacchetti": {
      "type": "rest",
      "method": "GET",
      "url": "/api/pacchetti"
    },
    "fatture": {
      "type": "rest",
      "method": "GET",
      "url": "/api/fatture",
      "params": {
        "stato": "inviata"
      }
    }
  },
  "components": [
    {
      "id": "titolo",
      "type": "text",
      "style": "heading",
      "text": "{{ t('vetrina_tabelle.filtri_e_tabelle', 'Filtri e tabelle') }}"
    },
    {
      "id": "intro",
      "type": "text",
      "text": "{{ t('vetrina_tabelle.una_barra_di_filtri_scrive_nello', 'Una barra di filtri scrive nello stato della schermata; la tabella ricarica da sola quando i filtri cambiano. Le righe hanno azioni condizionate dai permessi e dallo stato della riga.') }}"
    },
    {
      "id": "sezione-paginata",
      "type": "section",
      "title": "{{ t('vetrina_tabelle.tabella_con_filtri_paginazione_l', 'Tabella con filtri, paginazione lato server e azioni di riga') }}",
      "components": [
        {
          "id": "filtri",
          "type": "filterBar",
          "bind": "state.filtri",
          "fields": [
            {
              "name": "stato",
              "type": "select",
              "label": "{{ t('comune.stato', 'Stato') }}",
              "options": [
                "bozza",
                "inviato",
                "approvato"
              ],
              "optionKey": "valori.stato"
            }
          ]
        },
        {
          "id": "tabella-ordini",
          "type": "table",
          "source": "ordini",
          "columns": [
            {
              "field": "numero",
              "label": "{{ t('comune.numero', 'Numero') }}"
            },
            {
              "field": "cliente",
              "label": "{{ t('comune.cliente', 'Cliente') }}"
            },
            {
              "field": "tipo",
              "label": "{{ t('comune.tipo', 'Tipo') }}",
              "valueKey": "valori.tipo"
            },
            {
              "field": "sconto",
              "label": "{{ t('comune.sconto', 'Sconto') }}",
              "format": "percent"
            },
            {
              "field": "stato",
              "label": "{{ t('comune.stato', 'Stato') }}",
              "format": "badge",
              "badges": {
                "bozza": "neutral",
                "inviato": "primary",
                "approvato": "success"
              },
              "valueKey": "valori.stato"
            }
          ],
          "rowActions": [
            {
              "id": "btn-apri",
              "label": "{{ t('comune.apri', 'Apri') }}",
              "onClick": [
                {
                  "navigate": "ordine-dettaglio",
                  "params": {
                    "id": "{{row.id}}"
                  }
                }
              ]
            },
            {
              "id": "btn-approva",
              "label": "{{ t('comune.approva', 'Approva') }}",
              "visibleIf": "{{can('ordini.ordine.approva') && row.stato == 'inviato'}}",
              "onClick": [
                {
                  "confirm": "{{ t('vetrina_tabelle.approvare_l_ordine', 'Approvare l\\'ordine {numero}?', {'numero': dyn(row.numero)}) }}"
                },
                {
                  "call": "approvaOrdine",
                  "args": {
                    "id": "{{row.id}}"
                  },
                  "onError": {
                    "toast": "{{ t('comune.approvazione_non_riuscita', 'Approvazione non riuscita') }}"
                  }
                },
                {
                  "refresh": "ordini"
                },
                {
                  "toast": "{{ t('comune.ordine_approvato', 'Ordine approvato') }}"
                }
              ]
            },
            {
              "id": "btn-modifica",
              "label": "{{ t('vetrina_tabelle.modifica', 'Modifica') }}",
              "enabledIf": "{{row._perm.update}}",
              "onClick": [
                {
                  "navigate": "vetrina-form",
                  "params": {
                    "id": "{{row.id}}"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "sezione-semplice",
      "type": "section",
      "title": "{{ t('vetrina_tabelle.tabella_semplice_tutte_le_righe', 'Tabella semplice: tutte le righe in un array, senza filtri né pagine') }}",
      "components": [
        {
          "id": "tabella-pacchetti",
          "type": "table",
          "source": "pacchetti",
          "columns": [
            {
              "field": "nome",
              "label": "{{ t('comune.nome', 'Nome') }}"
            },
            {
              "field": "descrizione",
              "label": "{{ t('comune.descrizione', 'Descrizione') }}"
            },
            {
              "field": "creato",
              "label": "{{ t('comune.creato_il', 'Creato il') }}"
            }
          ]
        }
      ]
    },
    {
      "id": "sezione-formati",
      "type": "section",
      "title": "{{ t('vetrina_tabelle.formati_di_cella_importo_data_si', 'Formati di cella: importo, data, sì/no ed etichetta di stato') }}",
      "components": [
        {
          "id": "txt-formati",
          "type": "text",
          "text": "{{ t('vetrina_tabelle.le_fatture_inviate_ogni_colonna', 'Le fatture inviate: ogni colonna sceglie come mostrare il valore con la proprietà format. I valori restano quelli del servizio, cambia solo come si leggono.') }}"
        },
        {
          "id": "tabella-fatture",
          "type": "table",
          "source": "fatture",
          "columns": [
            {
              "field": "numero",
              "label": "{{ t('comune.numero', 'Numero') }}"
            },
            {
              "field": "cliente",
              "label": "{{ t('comune.cliente', 'Cliente') }}"
            },
            {
              "field": "importo",
              "label": "{{ t('comune.importo_2', 'Importo') }}",
              "format": "currency"
            },
            {
              "field": "emessa",
              "label": "{{ t('comune.emessa_il', 'Emessa il') }}",
              "format": "date"
            },
            {
              "field": "incassata",
              "label": "{{ t('comune.incassata', 'Incassata') }}",
              "format": "boolean"
            },
            {
              "field": "stato",
              "label": "{{ t('comune.stato', 'Stato') }}",
              "format": "badge",
              "badges": {
                "bozza": "neutral",
                "inviata": "primary",
                "pagata": "success"
              },
              "valueKey": "valori.stato"
            }
          ]
        }
      ]
    }
  ]
}
