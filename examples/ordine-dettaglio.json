{
  "schemaVersion": "1.0",
  "screen": "ordine-dettaglio",
  "title": "Dettaglio ordine",
  "requires": "ordini.ordine.leggi",
  "dataSources": {
    "ordine": { "type": "rest", "method": "GET", "url": "/api/ordini/{{params.id}}" },
    "salvaOrdine": { "type": "rest", "method": "PUT", "url": "/api/ordini/{{params.id}}", "body": "{{form}}" }
  },
  "components": [
    {
      "id": "form-ordine",
      "type": "form",
      "source": "ordine",
      "fields": [
        { "name": "cliente", "type": "text", "required": true },
        { "name": "tipo", "type": "select", "options": ["privato", "business"] },
        {
          "name": "sconto",
          "type": "number",
          "visibleIf": "{{form.tipo == 'business'}}",
          "validate": { "rule": "{{value <= 20}}", "message": "Sconto massimo 20%" }
        },
        {
          "name": "iban",
          "type": "text",
          "sensitive": true,
          "hiddenIf": "{{!can('ordini.iban.leggi')}}",
          "readOnlyIf": "{{!can('ordini.iban.scrivi')}}"
        }
      ],
      "actions": [
        {
          "id": "btn-salva",
          "label": "Salva",
          "enabledIf": "{{can('ordini.ordine.scrivi') && form._perm.update}}",
          "onClick": [
            { "call": "salvaOrdine", "onError": { "toast": "Salvataggio non riuscito" } },
            { "navigate": "ordini-elenco" }
          ]
        }
      ]
    }
  ]
}
