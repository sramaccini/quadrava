{
  "schemaVersion": "1.0",
  "screen": "ordine-dettaglio",
  "title": "{{ t('ordine_dettaglio.dettaglio_ordine', 'Dettaglio ordine') }}",
  "requires": "ordini.ordine.leggi",
  "dataSources": {
    "ordine": {
      "type": "rest",
      "method": "GET",
      "url": "/api/ordini/{{params.id}}"
    },
    "salvaOrdine": {
      "type": "rest",
      "method": "PUT",
      "url": "/api/ordini/{{params.id}}",
      "body": "{{form}}"
    }
  },
  "components": [
    {
      "id": "form-ordine",
      "type": "form",
      "source": "ordine",
      "fields": [
        {
          "name": "cliente",
          "label": "{{ t('comune.cliente', 'Cliente') }}",
          "type": "text",
          "required": true
        },
        {
          "name": "tipo",
          "label": "{{ t('comune.tipo', 'Tipo') }}",
          "type": "select",
          "options": [
            "privato",
            "business"
          ],
          "optionKey": "valori.tipo"
        },
        {
          "name": "sconto",
          "label": "{{ t('comune.sconto', 'Sconto') }}",
          "type": "number",
          "visibleIf": "{{form.tipo == 'business'}}",
          "validate": {
            "rule": "{{value <= 20}}",
            "message": "{{ t('comune.sconto_massimo_20', 'Sconto massimo 20%') }}"
          }
        },
        {
          "name": "iban",
          "label": "{{ t('vetrina_layout.iban', 'IBAN') }}",
          "type": "text",
          "sensitive": true,
          "hiddenIf": "{{!can('ordini.iban.leggi')}}",
          "readOnlyIf": "{{!can('ordini.iban.scrivi')}}"
        }
      ],
      "actions": [
        {
          "id": "btn-salva",
          "label": "{{ t('comune.salva', 'Salva') }}",
          "enabledIf": "{{can('ordini.ordine.scrivi') && form._perm.update}}",
          "onClick": [
            {
              "call": "salvaOrdine",
              "onError": {
                "toast": "{{ t('comune.salvataggio_non_riuscito', 'Salvataggio non riuscito') }}"
              }
            },
            {
              "navigate": "ordini-elenco"
            }
          ]
        }
      ]
    }
  ]
}
