{
  "schemaVersion": "1.0",
  "screen": "vetrina-cruscotto",
  "title": "{{ t('vetrina_cruscotto.titolo', 'Vetrina: cruscotto') }}",
  "description": "{{ t('vetrina_cruscotto.descrizione', 'Indicatori e grafici calcolati dai dati del servizio.') }}",
  "requires": "vetrina.componenti.leggi",
  "dataSources": {
    "riepilogo": {
      "type": "rest",
      "method": "GET",
      "url": "/api/riepilogo"
    },
    "vendite": {
      "type": "rest",
      "method": "GET",
      "url": "/api/vendite-mensili"
    },
    "perStato": {
      "type": "rest",
      "method": "GET",
      "url": "/api/fatture-per-stato"
    }
  },
  "components": [
    {
      "id": "titolo",
      "type": "text",
      "style": "heading",
      "text": "{{ t('vetrina_cruscotto.intestazione', 'Cruscotto') }}"
    },
    {
      "id": "sezione-kpi",
      "type": "section",
      "title": "{{ t('vetrina_cruscotto.indicatori', 'Indicatori') }}",
      "components": [
        {
          "id": "kpi-fatture",
          "type": "stats",
          "source": "riepilogo",
          "items": [
            {
              "id": "kpi-fatturato",
              "label": "{{ t('vetrina_cruscotto.fatturato', 'Fatturato') }}",
              "field": "fatturato",
              "format": "currency",
              "tone": "success",
              "caption": "{{ t('vetrina_cruscotto.crescita', '+{p, number} % rispetto al mese scorso', {'p': row.crescita}) }}"
            },
            {
              "id": "kpi-incassare",
              "label": "{{ t('vetrina_cruscotto.da_incassare', 'Da incassare') }}",
              "field": "daIncassare",
              "format": "currency",
              "tone": "primary",
              "tooltip": "{{ t('vetrina_cruscotto.da_incassare_aiuto', 'Fatture attive inviate e non ancora pagate') }}"
            },
            {
              "id": "kpi-aperte",
              "label": "{{ t('vetrina_cruscotto.aperte', 'Fatture aperte') }}",
              "field": "aperte",
              "format": "number",
              "decimals": 0,
              "tone": "danger",
              "caption": "{{ t('vetrina_cruscotto.su_totale', 'su {n} in tutto', {'n': row.totale}) }}"
            },
            {
              "id": "kpi-media",
              "label": "{{ t('vetrina_cruscotto.media_cliente', 'Fatturato medio per cliente') }}",
              "value": "{{ row.fatturato / row.clienti }}",
              "format": "currency"
            }
          ]
        }
      ]
    },
    {
      "id": "sezione-grafici",
      "type": "section",
      "title": "{{ t('vetrina_cruscotto.grafici', 'Grafici') }}",
      "components": [
        {
          "id": "spiega-grafici",
          "type": "text",
          "text": "{{ t('vetrina_cruscotto.grafici_spiega', 'Disegnati in SVG con i colori del tema: passa con il mouse su barre, punti e fette per leggere i valori. Per gli screen reader ogni grafico è anche una tabella.') }}"
        },
        {
          "id": "grafico-barre",
          "type": "chart",
          "kind": "bar",
          "source": "vendite",
          "categoryField": "mese",
          "categoryFormat": "month",
          "series": [
            {
              "field": "attive",
              "label": "{{ t('vetrina_cruscotto.attive', 'Fatture attive') }}"
            },
            {
              "field": "passive",
              "label": "{{ t('vetrina_cruscotto.passive', 'Fatture passive') }}",
              "tone": "danger"
            }
          ],
          "format": "currency",
          "caption": "{{ t('vetrina_cruscotto.barre_didascalia', 'Fatture attive e passive per mese, 2026') }}"
        },
        {
          "id": "grafico-combinato",
          "type": "chart",
          "kind": "bar",
          "stacked": true,
          "source": "vendite",
          "categoryField": "mese",
          "categoryFormat": "month",
          "format": "currency",
          "rightFormat": "percent",
          "decimals": 1,
          "series": [
            {
              "field": "attive",
              "label": "{{ t('vetrina_cruscotto.attive', 'Fatture attive') }}"
            },
            {
              "field": "passive",
              "label": "{{ t('vetrina_cruscotto.passive', 'Fatture passive') }}",
              "tone": "danger"
            },
            {
              "field": "margine",
              "label": "{{ t('vetrina_cruscotto.margine', 'Margine') }}",
              "kind": "line",
              "axis": "right",
              "tone": "success"
            }
          ],
          "caption": "{{ t('vetrina_cruscotto.combinato_didascalia', 'Fatture attive e passive impilate per mese e margine percentuale sull’asse destro, 2026') }}"
        },
        {
          "id": "grafico-linee",
          "type": "chart",
          "kind": "line",
          "source": "vendite",
          "categoryField": "mese",
          "categoryFormat": "month",
          "series": [
            {
              "field": "attive",
              "label": "{{ t('vetrina_cruscotto.attive', 'Fatture attive') }}"
            }
          ],
          "format": "currency",
          "height": 220,
          "caption": "{{ t('vetrina_cruscotto.linee_didascalia', 'Andamento delle fatture attive, 2026') }}"
        },
        {
          "id": "grafico-torta",
          "type": "chart",
          "kind": "pie",
          "source": "perStato",
          "categoryField": "stato",
          "categoryKey": "valori.stato",
          "series": [
            {
              "field": "numero",
              "label": "{{ t('vetrina_cruscotto.numero_fatture', 'Numero di fatture') }}"
            }
          ],
          "format": "number",
          "decimals": 0,
          "height": 240,
          "caption": "{{ t('vetrina_cruscotto.torta_didascalia', 'Fatture per stato') }}"
        }
      ]
    }
  ]
}
