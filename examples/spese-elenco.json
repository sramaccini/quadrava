{
  "schemaVersion": "1.0",
  "screen": "spese-elenco",
  "title": "{{ t('spese_elenco.revisione_spese', 'Revisione spese') }}",
  "requires": "spese.spesa.leggi",
  "dataSources": {
    "spese": {
      "type": "rest",
      "method": "GET",
      "url": "/api/spese",
      "paging": "server",
      "params": {
        "stato": "{{has(params.stato) ? params.stato : ''}}",
        "page": "{{state.page}}"
      }
    },
    "revisionaSpesa": {
      "type": "rest",
      "method": "POST",
      "url": "/api/spese/{{id}}/revisiona",
      "body": {
        "esito": "{{esito}}"
      }
    }
  },
  "components": [
    {
      "id": "tabella-spese",
      "type": "table",
      "source": "spese",
      "columns": [
        {
          "field": "descrizione",
          "label": "{{ t('comune.descrizione', 'Descrizione') }}"
        },
        {
          "field": "dipendente",
          "label": "{{ t('spese_elenco.dipendente', 'Dipendente') }}"
        },
        {
          "field": "importo",
          "label": "{{ t('comune.importo', 'Importo (€)') }}"
        },
        {
          "field": "stato",
          "label": "{{ t('comune.stato', 'Stato') }}",
          "valueKey": "valori.stato"
        }
      ],
      "rowActions": [
        {
          "id": "btn-approva-spesa",
          "label": "{{ t('comune.approva', 'Approva') }}",
          "visibleIf": "{{can('spese.spesa.revisiona') && row.stato == 'da-revisionare'}}",
          "onClick": [
            {
              "call": "revisionaSpesa",
              "args": {
                "id": "{{row.id}}",
                "esito": "approvata"
              },
              "onError": {
                "toast": "{{ t('spese_elenco.operazione_non_riuscita', 'Operazione non riuscita') }}"
              }
            },
            {
              "refresh": "spese"
            },
            {
              "toast": "{{ t('spese_elenco.spesa_approvata', 'Spesa approvata') }}"
            }
          ]
        },
        {
          "id": "btn-respingi-spesa",
          "label": "{{ t('spese_elenco.respingi', 'Respingi') }}",
          "visibleIf": "{{can('spese.spesa.revisiona') && row.stato == 'da-revisionare'}}",
          "onClick": [
            {
              "call": "revisionaSpesa",
              "args": {
                "id": "{{row.id}}",
                "esito": "respinta"
              },
              "onError": {
                "toast": "{{ t('spese_elenco.operazione_non_riuscita', 'Operazione non riuscita') }}"
              }
            },
            {
              "refresh": "spese"
            },
            {
              "toast": "{{ t('spese_elenco.spesa_respinta', 'Spesa respinta') }}"
            }
          ]
        }
      ]
    }
  ]
}
