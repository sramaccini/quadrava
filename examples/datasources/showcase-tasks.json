{
  "schemaVersion": "1.0",
  "datasources": "showcase-tasks",
  "description": "Calls used by the «showcase-tasks» showcase screen.",
  "sources": {
    "tasks": {
      "type": "rest",
      "method": "GET",
      "url": "/api/tasks"
    },
    "statuses": {
      "type": "rest",
      "method": "GET",
      "url": "/api/task-statuses"
    },
    "moveTask": {
      "type": "rest",
      "method": "POST",
      "url": "/api/tasks/{{ id }}/move",
      "body": {
        "status": "{{ status }}",
        "beforeId": "{{ beforeId }}",
        "afterId": "{{ afterId }}"
      }
    },
    "events": {
      "type": "rest",
      "method": "GET",
      "url": "/api/events"
    }
  }
}
