{
  "schemaVersion": "1.0",
  "datasources": "showcase-tasks",
  "description": "Calls used by the «showcase-tasks» showcase screen.",
  "sources": {
    "tasks": {
      "type": "rest",
      "method": "GET",
      "url": "/api/tasks"
    },
    "statuses": {
      "type": "rest",
      "method": "GET",
      "url": "/api/task-statuses"
    },
    "moveTask": {
      "type": "rest",
      "method": "POST",
      "url": "/api/tasks/{{ id }}/move",
      "body": {
        "status": "{{ status }}",
        "beforeId": "{{ beforeId }}",
        "afterId": "{{ afterId }}"
      }
    },
    "events": {
      "type": "rest",
      "method": "GET",
      "url": "/api/events"
    },
    "comments": {
      "type": "rest",
      "method": "GET",
      "url": "/api/task-comments"
    },
    "addComment": {
      "type": "rest",
      "method": "POST",
      "url": "/api/task-comments",
      "body": {
        "text": "{{ text }}",
        "mentions": "{{ mentions }}",
        "author": "{{ user.username }}"
      }
    },
    "people": {
      "type": "rest",
      "method": "GET",
      "url": "/api/people",
      "params": {
        "q": "{{ search }}"
      }
    }
  }
}
