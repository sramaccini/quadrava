{
  "schemaVersion": "1.0",
  "screen": "vetrina-form",
  "title": "{{ t('vetrina_form.vetrina_form', 'Vetrina: form') }}",
  "requires": "vetrina.componenti.leggi",
  "dataSources": {
    "salva": {
      "type": "rest",
      "method": "POST",
      "url": "/api/vetrina/segnala",
      "body": "{{form}}"
    },
    "ordine": {
      "type": "rest",
      "method": "GET",
      "url": "/api/ordini/{{has(params.id) ? params.id : 1}}"
    },
    "salvaOrdine": {
      "type": "rest",
      "method": "PUT",
      "url": "/api/ordini/{{has(params.id) ? params.id : 1}}",
      "body": "{{form}}"
    }
  },
  "components": [
    {
      "id": "titolo",
      "type": "text",
      "style": "heading",
      "text": "{{ t('vetrina_form.form', 'Form') }}"
    },
    {
      "id": "intro",
      "type": "text",
      "text": "{{ t('vetrina_form.tutti_i_tipi_di_campo_i_campi_ob', 'Tutti i tipi di campo, i campi obbligatori, la validazione con regole, i campi che compaiono, si bloccano o spariscono in base ai valori e ai permessi.') }}"
    },
    {
      "id": "sezione-inserimento",
      "type": "section",
      "title": "{{ t('vetrina_form.form_di_inserimento_tutti_i_tipi', 'Form di inserimento: tutti i tipi di campo') }}",
      "components": [
        {
          "id": "form-tipi",
          "type": "form",
          "initial": {
            "categoria": "privato",
            "newsletter": true
          },
          "fields": [
            {
              "name": "nome",
              "type": "text",
              "label": "{{ t('comune.nome', 'Nome') }}",
              "required": true
            },
            {
              "name": "eta",
              "type": "number",
              "label": "{{ t('vetrina_form.eta', 'Età') }}",
              "validate": {
                "rule": "{{value >= 18 && value <= 120}}",
                "message": "{{ t('vetrina_form.l_eta_deve_essere_tra_18_e_120', 'L\\'età deve essere tra 18 e 120') }}"
              }
            },
            {
              "name": "categoria",
              "type": "select",
              "label": "{{ t('vetrina_form.categoria', 'Categoria') }}",
              "options": [
                "privato",
                "business"
              ],
              "required": true,
              "optionKey": "valori.tipo"
            },
            {
              "name": "partitaIva",
              "type": "text",
              "label": "{{ t('vetrina_form.partita_iva_solo_business', 'Partita IVA (solo business)') }}",
              "visibleIf": "{{form.categoria == 'business'}}",
              "required": true,
              "validate": {
                "rule": "{{size(string(value)) == 11}}",
                "message": "{{ t('vetrina_form.la_partita_iva_ha_11_cifre', 'La partita IVA ha 11 cifre') }}"
              }
            },
            {
              "name": "nascita",
              "type": "date",
              "label": "{{ t('vetrina_form.data_di_nascita', 'Data di nascita') }}"
            },
            {
              "name": "newsletter",
              "type": "checkbox",
              "label": "{{ t('vetrina_form.desidero_ricevere_la_newsletter', 'Desidero ricevere la newsletter') }}"
            },
            {
              "name": "codiceFiscale",
              "type": "text",
              "label": "{{ t('vetrina_form.codice_fiscale_dato_sensibile', 'Codice fiscale (dato sensibile)') }}",
              "sensitive": true
            }
          ],
          "actions": [
            {
              "id": "btn-invia",
              "label": "{{ t('vetrina_form.invia', 'Invia') }}",
              "onClick": [
                {
                  "call": "salva",
                  "onError": {
                    "toast": "{{ t('vetrina_form.invio_non_riuscito', 'Invio non riuscito') }}"
                  }
                },
                {
                  "toast": "{{ t('vetrina_form.dati_inviati', 'Dati inviati') }}"
                }
              ]
            },
            {
              "id": "btn-azzera",
              "label": "{{ t('vetrina_form.che_cosa_ricevono_le_azioni', 'Che cosa ricevono le azioni?') }}",
              "onClick": [
                {
                  "toast": "{{ t('vetrina_form.le_azioni_di_un_form_ricevono_i', 'Le azioni di un form ricevono i valori in \\'form\\'') }}"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "sezione-modifica",
      "type": "section",
      "title": "{{ t('vetrina_form.form_di_modifica_dati_dal_serviz', 'Form di modifica: dati dal servizio, campi e azioni secondo i permessi') }}",
      "components": [
        {
          "id": "form-ordine",
          "type": "form",
          "source": "ordine",
          "fields": [
            {
              "name": "cliente",
              "label": "{{ t('comune.cliente', 'Cliente') }}",
              "type": "text",
              "required": true
            },
            {
              "name": "tipo",
              "label": "{{ t('comune.tipo', 'Tipo') }}",
              "type": "select",
              "options": [
                "privato",
                "business"
              ],
              "optionKey": "valori.tipo"
            },
            {
              "name": "sconto",
              "label": "{{ t('comune.sconto', 'Sconto') }}",
              "type": "number",
              "visibleIf": "{{form.tipo == 'business'}}",
              "validate": {
                "rule": "{{value <= 20}}",
                "message": "{{ t('comune.sconto_massimo_20', 'Sconto massimo 20%') }}"
              }
            },
            {
              "name": "iban",
              "label": "{{ t('vetrina_layout.iban', 'IBAN') }}",
              "type": "text",
              "sensitive": true,
              "hiddenIf": "{{!can('ordini.iban.leggi')}}",
              "readOnlyIf": "{{!can('ordini.iban.scrivi')}}"
            }
          ],
          "actions": [
            {
              "id": "btn-salva",
              "label": "{{ t('comune.salva', 'Salva') }}",
              "enabledIf": "{{can('ordini.ordine.scrivi') && form._perm.update}}",
              "onClick": [
                {
                  "call": "salvaOrdine",
                  "onError": {
                    "toast": "{{ t('comune.salvataggio_non_riuscito', 'Salvataggio non riuscito') }}"
                  }
                },
                {
                  "toast": "{{ t('vetrina_form.ordine_salvato', 'Ordine salvato') }}"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
