{
  "schemaVersion": "1.0",
  "screen": "vetrina-datatable",
  "title": "{{ t('vetrina_datatable.titolo', 'Vetrina: datatable') }}",
  "description": "{{ t('vetrina_datatable.descrizione', 'Colonne filtrabili, ordinabili e raggruppabili, con totali per gruppo.') }}",
  "requires": "vetrina.componenti.leggi",
  "dataSources": {
    "movimenti": {
      "type": "rest",
      "method": "GET",
      "url": "/api/movimenti"
    },
    "archivio": {
      "type": "rest",
      "method": "GET",
      "url": "/api/movimenti",
      "params": {
        "quanti": 20000
      }
    },
    "ricerca": {
      "type": "rest",
      "method": "POST",
      "url": "/api/movimenti/ricerca",
      "body": "{{ request }}"
    },
    "verificaMovimento": {
      "type": "rest",
      "method": "POST",
      "url": "/api/movimenti/{{ id }}/verifica"
    }
  },
  "components": [
    {
      "id": "titolo",
      "type": "text",
      "style": "heading",
      "text": "{{ t('vetrina_datatable.intestazione', 'Datatable') }}"
    },
    {
      "id": "sezione-movimenti",
      "type": "section",
      "title": "{{ t('vetrina_datatable.movimenti', 'Movimenti dei conti') }}",
      "components": [
        {
          "id": "spiega-movimenti",
          "type": "text",
          "text": "{{ t('vetrina_datatable.spiega', 'Sessanta movimenti caricati una volta sola: filtra dall’icona nelle intestazioni, ordina con le frecce, scegli una o più colonne per raggruppare. Ogni gruppo mostra il numero di movimenti e il saldo.') }}"
        },
        {
          "id": "datatable-movimenti",
          "type": "dataTable",
          "source": "movimenti",
          "groupBy": [
            "conto"
          ],
          "defaultSort": {
            "field": "data",
            "direction": "desc"
          },
          "pageSize": 15,
          "rowActionsInline": 1,
          "columns": [
            {
              "field": "data",
              "label": "{{ t('vetrina_datatable.data', 'Data') }}",
              "format": "date",
              "sortable": true,
              "filter": "date"
            },
            {
              "field": "conto",
              "label": "{{ t('vetrina_datatable.conto', 'Conto') }}",
              "sortable": true,
              "filter": "select",
              "groupable": true
            },
            {
              "field": "categoria",
              "label": "{{ t('vetrina_datatable.categoria', 'Categoria') }}",
              "filter": "select",
              "groupable": true,
              "aggregate": "count"
            },
            {
              "field": "descrizione",
              "label": "{{ t('comune.descrizione', 'Descrizione') }}",
              "filter": "text"
            },
            {
              "field": "stato",
              "label": "{{ t('comune.stato', 'Stato') }}",
              "format": "badge",
              "badges": {
                "registrato": "success",
                "da-verificare": "danger"
              },
              "valueKey": "valori.movimento",
              "filter": "select",
              "groupable": true
            },
            {
              "field": "importo",
              "label": "{{ t('comune.importo', 'Importo') }}",
              "format": "currency",
              "sortable": true,
              "filter": "number",
              "aggregate": "sum"
            }
          ],
          "rowActions": [
            {
              "id": "btn-verifica",
              "label": "{{ t('vetrina_datatable.verifica', 'Verifica') }}",
              "enabledIf": "{{ row.stato == 'da-verificare' }}",
              "onClick": [
                {
                  "toast": "{{ t('vetrina_datatable.verificato', 'Movimento {d} verificato (esempio)', {'d': row.descrizione}) }}"
                }
              ]
            },
            {
              "id": "btn-dettagli",
              "label": "{{ t('vetrina_datatable.dettagli', 'Dettagli') }}",
              "onClick": [
                {
                  "toast": "{{ t('vetrina_datatable.dettagli_msg', '{d}: {i}', {'d': dyn(row.descrizione), 'i': dyn(fmtCurrency(row.importo, 'EUR'))}) }}"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "sezione-archivio",
      "type": "section",
      "title": "{{ t('vetrina_datatable.archivio', 'Grandi volumi: 20.000 movimenti') }}",
      "components": [
        {
          "id": "spiega-archivio",
          "type": "text",
          "text": "{{ t('vetrina_datatable.archivio_spiega', 'Lo stesso componente con 20.000 righe caricate in una volta: si disegna solo la pagina corrente, i testi delle celle si calcolano una volta sola e il filtro di testo aspetta una breve pausa tra le battute.') }}"
        },
        {
          "id": "datatable-archivio",
          "type": "dataTable",
          "source": "archivio",
          "groupBy": [
            "conto",
            "categoria"
          ],
          "pageSize": 20,
          "columns": [
            {
              "field": "data",
              "label": "{{ t('vetrina_datatable.data', 'Data') }}",
              "format": "date",
              "sortable": true,
              "filter": "date"
            },
            {
              "field": "conto",
              "label": "{{ t('vetrina_datatable.conto', 'Conto') }}",
              "sortable": true,
              "filter": "select",
              "groupable": true
            },
            {
              "field": "categoria",
              "label": "{{ t('vetrina_datatable.categoria', 'Categoria') }}",
              "filter": "select",
              "groupable": true,
              "aggregate": "count"
            },
            {
              "field": "descrizione",
              "label": "{{ t('comune.descrizione', 'Descrizione') }}",
              "filter": "text"
            },
            {
              "field": "stato",
              "label": "{{ t('comune.stato', 'Stato') }}",
              "format": "badge",
              "badges": {
                "registrato": "success",
                "da-verificare": "danger"
              },
              "valueKey": "valori.movimento",
              "filter": "select",
              "groupable": true
            },
            {
              "field": "importo",
              "label": "{{ t('comune.importo', 'Importo') }}",
              "format": "currency",
              "sortable": true,
              "filter": "number",
              "aggregate": "sum"
            }
          ]
        }
      ]
    },
    {
      "id": "sezione-server",
      "type": "section",
      "title": "{{ t('vetrina_datatable.server', 'Lato server: 200.000 movimenti') }}",
      "components": [
        {
          "id": "spiega-server",
          "type": "text",
          "text": "{{ t('vetrina_datatable.server_spiega', 'Stessa interfaccia, ma filtri, ordinamento, gruppi, totali e pagine li calcola il servizio: il browser riceve solo la pagina e i gruppi che si vedono. Aprendo un gruppo si caricano le sue righe a pagine.') }}"
        },
        {
          "id": "tabella-server",
          "type": "serverDataTable",
          "source": "ricerca",
          "groupBy": [
            "conto"
          ],
          "defaultSort": {
            "field": "data",
            "direction": "desc"
          },
          "pageSize": 15,
          "bind": "state.ricercaMovimenti",
          "rowActionsInline": 1,
          "columns": [
            {
              "field": "data",
              "label": "{{ t('vetrina_datatable.data', 'Data') }}",
              "format": "date",
              "sortable": true,
              "filter": "date"
            },
            {
              "field": "conto",
              "label": "{{ t('vetrina_datatable.conto', 'Conto') }}",
              "sortable": true,
              "filter": "select",
              "groupable": true
            },
            {
              "field": "categoria",
              "label": "{{ t('vetrina_datatable.categoria', 'Categoria') }}",
              "filter": "select",
              "groupable": true,
              "aggregate": "count"
            },
            {
              "field": "descrizione",
              "label": "{{ t('comune.descrizione', 'Descrizione') }}",
              "filter": "text"
            },
            {
              "field": "stato",
              "label": "{{ t('comune.stato', 'Stato') }}",
              "format": "badge",
              "badges": {
                "registrato": "success",
                "da-verificare": "danger"
              },
              "valueKey": "valori.movimento",
              "filter": "select",
              "groupable": true
            },
            {
              "field": "importo",
              "label": "{{ t('comune.importo', 'Importo') }}",
              "format": "currency",
              "sortable": true,
              "filter": "number",
              "aggregate": "sum"
            }
          ],
          "rowActions": [
            {
              "id": "btn-verifica-server",
              "label": "{{ t('vetrina_datatable.verifica', 'Verifica') }}",
              "enabledIf": "{{ row.stato == 'da-verificare' }}",
              "onClick": [
                {
                  "call": "verificaMovimento",
                  "args": {
                    "id": "{{ row.id }}"
                  }
                },
                {
                  "refresh": "ricerca"
                },
                {
                  "toast": "{{ t('vetrina_datatable.verificato_server', 'Movimento {d} verificato', {'d': row.descrizione}) }}"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
