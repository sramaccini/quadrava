{
  "schemaVersion": "1.0",
  "screen": "vetrina-campi",
  "title": "{{ t('vetrina_campi.titolo', 'Vetrina: campi e form') }}",
  "description": "{{ t('vetrina_campi.descrizione', 'Tipi di campo aggiuntivi, ricerca su data source, file, griglia, righe ripetibili e dialog con form.') }}",
  "requires": "vetrina.componenti.leggi",
  "dataSources": {
    "fatture": {
      "type": "rest",
      "method": "GET",
      "url": "/api/fatture",
      "params": {
        "stato": "{{state.filtriCampi.stati}}",
        "tipo": "{{state.filtriCampi.tipo}}",
        "cliente": "{{state.filtriCampi.cliente}}"
      }
    },
    "clienti": {
      "type": "rest",
      "method": "GET",
      "url": "/api/clienti",
      "params": {
        "q": "{{ search }}",
        "id": "{{ lookupKey }}"
      }
    },
    "caricaAllegato": {
      "type": "rest",
      "method": "POST",
      "url": "/api/allegati",
      "body": "{{ file }}"
    },
    "contatti": {
      "type": "rest",
      "method": "GET",
      "url": "/api/contatti"
    },
    "creaContatto": {
      "type": "rest",
      "method": "POST",
      "url": "/api/contatti",
      "body": "{{ form }}"
    },
    "modificaContatto": {
      "type": "rest",
      "method": "PUT",
      "url": "/api/contatti/{{ id }}",
      "body": "{{ form }}"
    }
  },
  "components": [
    {
      "id": "titolo",
      "type": "text",
      "style": "heading",
      "text": "{{ t('vetrina_campi.intestazione', 'Campi e form') }}"
    },
    {
      "id": "sezione-tipi",
      "type": "section",
      "title": "{{ t('vetrina_campi.nuovi_tipi', 'Nuovi tipi di campo') }}",
      "components": [
        {
          "id": "form-tipi",
          "type": "form",
          "initial": {
            "consegna": "2026-10-20T09:30",
            "urgente": false,
            "canali": [
              "email"
            ]
          },
          "fields": [
            {
              "name": "note",
              "type": "textarea",
              "label": "{{ t('vetrina_campi.note', 'Note per il corriere') }}",
              "rows": 3,
              "required": true
            },
            {
              "name": "consegna",
              "type": "datetime",
              "label": "{{ t('vetrina_campi.consegna', 'Consegna') }}",
              "tooltip": "{{ t('vetrina_campi.consegna_aiuto', 'Data e ora, nell’ora locale') }}"
            },
            {
              "name": "priorita",
              "type": "radio",
              "label": "{{ t('vetrina_campi.priorita', 'Priorità') }}",
              "options": [
                "bassa",
                "normale",
                "alta"
              ],
              "optionKey": "valori.priorita"
            },
            {
              "name": "urgente",
              "type": "switch",
              "label": "{{ t('vetrina_campi.urgente', 'Spedizione urgente') }}"
            },
            {
              "name": "canali",
              "type": "multiselect",
              "label": "{{ t('vetrina_campi.canali', 'Avvisi via') }}",
              "options": [
                "email",
                "sms",
                "app"
              ],
              "optionKey": "valori.canale",
              "required": true
            }
          ],
          "actions": [
            {
              "id": "btn-invia-tipi",
              "label": "{{ t('vetrina_campi.invia', 'Invia') }}",
              "onClick": [
                {
                  "toast": "{{ t('vetrina_campi.inviato', 'Priorità {p}, {u, select, true {spedizione urgente} other {spedizione normale}}, avvisi su {n} canali', {'p': dyn(form.priorita == null ? '—' : form.priorita), 'u': dyn(string(form.urgente == true)), 'n': dyn(size(form.canali))}) }}"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "sezione-lookup",
      "type": "section",
      "title": "{{ t('vetrina_campi.lookup', 'Ricerca su data source (lookup)') }}",
      "components": [
        {
          "id": "spiega-lookup",
          "type": "text",
          "text": "{{ t('vetrina_campi.lookup_spiega', 'Scrivi almeno due lettere del nome o della città: il campo interroga il servizio dei clienti e propone i risultati. Il valore salvato è l’id del cliente; il form parte con un cliente che non è tra i primi risultati, e il campo ne chiede il nome al servizio.') }}"
        },
        {
          "id": "form-lookup",
          "type": "form",
          "fields": [
            {
              "name": "cliente",
              "type": "lookup",
              "label": "{{ t('comune.cliente', 'Cliente') }}",
              "required": true,
              "lookup": {
                "source": "clienti",
                "valueField": "id",
                "labelField": "nome",
                "minChars": 2
              }
            }
          ],
          "actions": [
            {
              "id": "btn-scegli-cliente",
              "label": "{{ t('vetrina_campi.conferma', 'Conferma') }}",
              "onClick": [
                {
                  "toast": "{{ t('vetrina_campi.cliente_scelto', 'Cliente scelto: id {id}', {'id': form.cliente}) }}"
                }
              ]
            }
          ],
          "initial": {
            "cliente": 12
          }
        }
      ]
    },
    {
      "id": "sezione-file",
      "type": "section",
      "title": "{{ t('vetrina_campi.file', 'Caricamento di file') }}",
      "components": [
        {
          "id": "spiega-file",
          "type": "text",
          "text": "{{ t('vetrina_campi.file_spiega', 'PDF o immagini fino a 2 MB. Il file parte subito verso il servizio, che risponde con un id; il form salva poi l’id insieme al nome.') }}"
        },
        {
          "id": "form-file",
          "type": "form",
          "fields": [
            {
              "name": "allegato",
              "type": "file",
              "label": "{{ t('vetrina_campi.allegato', 'Allegato') }}",
              "accept": ".pdf,image/*",
              "maxSizeKb": 2048,
              "upload": "caricaAllegato",
              "required": true
            },
            {
              "name": "descrizione",
              "type": "text",
              "label": "{{ t('comune.descrizione', 'Descrizione') }}"
            }
          ],
          "actions": [
            {
              "id": "btn-salva-allegato",
              "label": "{{ t('comune.salva', 'Salva') }}",
              "onClick": [
                {
                  "toast": "{{ t('vetrina_campi.allegato_salvato', 'Allegato {nome} salvato (id {id})', {'nome': dyn(form.allegato.name), 'id': dyn(form.allegato.id)}) }}"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "sezione-griglia",
      "type": "section",
      "title": "{{ t('vetrina_campi.griglia', 'Griglia a colonne') }}",
      "components": [
        {
          "id": "spiega-griglia",
          "type": "text",
          "text": "{{ t('vetrina_campi.griglia_spiega', 'Il form ha tre colonne (columns: 3); ragione sociale e indirizzo ne occupano due (span: 2), le note tutte. Restringendo la finestra il form torna a una colonna.') }}"
        },
        {
          "id": "form-griglia",
          "type": "form",
          "columns": 3,
          "fields": [
            {
              "name": "ragioneSociale",
              "type": "text",
              "label": "{{ t('vetrina_campi.ragione_sociale', 'Ragione sociale') }}",
              "span": 2,
              "required": true
            },
            {
              "name": "partitaIva",
              "type": "text",
              "label": "{{ t('vetrina_campi.partita_iva', 'Partita IVA') }}"
            },
            {
              "name": "indirizzo",
              "type": "text",
              "label": "{{ t('vetrina_campi.indirizzo', 'Indirizzo') }}",
              "span": 2
            },
            {
              "name": "cap",
              "type": "text",
              "label": "{{ t('vetrina_campi.cap', 'CAP') }}"
            },
            {
              "name": "citta",
              "type": "text",
              "label": "{{ t('vetrina_campi.citta', 'Città') }}"
            },
            {
              "name": "provincia",
              "type": "select",
              "label": "{{ t('vetrina_campi.provincia', 'Provincia') }}",
              "options": [
                "MI",
                "TO",
                "BO",
                "RM",
                "NA"
              ]
            },
            {
              "name": "cliente",
              "type": "switch",
              "label": "{{ t('vetrina_campi.gia_cliente', 'Già cliente') }}"
            },
            {
              "name": "note",
              "type": "textarea",
              "label": "{{ t('vetrina_campi.note_generali', 'Note') }}",
              "rows": 2,
              "span": 3
            }
          ],
          "actions": [
            {
              "id": "btn-salva-anagrafica",
              "label": "{{ t('comune.salva', 'Salva') }}",
              "onClick": [
                {
                  "toast": "{{ t('vetrina_campi.anagrafica_salvata', 'Anagrafica di {nome} salvata', {'nome': form.ragioneSociale}) }}"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "sezione-righe",
      "type": "section",
      "title": "{{ t('vetrina_campi.righe', 'Righe ripetibili') }}",
      "components": [
        {
          "id": "spiega-righe",
          "type": "text",
          "text": "{{ t('vetrina_campi.righe_spiega', 'Le righe di un ordine: almeno una, al massimo dieci. Articolo obbligatorio e quantità maggiore di zero, controllati riga per riga al salvataggio.') }}"
        },
        {
          "id": "form-righe",
          "type": "form",
          "initial": {
            "righe": [
              {
                "articolo": "Risma carta A4",
                "quantita": 5,
                "prezzo": 4.9,
                "omaggio": false
              }
            ]
          },
          "fields": [
            {
              "name": "righe",
              "type": "repeater",
              "label": "{{ t('vetrina_campi.righe_ordine', 'Righe dell’ordine') }}",
              "minRows": 1,
              "maxRows": 10,
              "addLabel": "{{ t('vetrina_campi.aggiungi_articolo', 'Aggiungi un articolo') }}",
              "fields": [
                {
                  "name": "articolo",
                  "type": "text",
                  "label": "{{ t('vetrina_campi.articolo', 'Articolo') }}",
                  "required": true
                },
                {
                  "name": "quantita",
                  "type": "number",
                  "label": "{{ t('vetrina_campi.quantita', 'Quantità') }}",
                  "required": true,
                  "validate": {
                    "rule": "{{ value > 0 }}",
                    "message": "{{ t('vetrina_campi.quantita_positiva', 'Deve essere maggiore di zero') }}"
                  }
                },
                {
                  "name": "prezzo",
                  "type": "number",
                  "label": "{{ t('vetrina_campi.prezzo', 'Prezzo (€)') }}"
                },
                {
                  "name": "omaggio",
                  "type": "checkbox",
                  "label": "{{ t('vetrina_campi.omaggio', 'Omaggio') }}"
                }
              ]
            }
          ],
          "actions": [
            {
              "id": "btn-salva-righe",
              "label": "{{ t('comune.salva', 'Salva') }}",
              "onClick": [
                {
                  "toast": "{{ t('vetrina_campi.righe_salvate', 'Ordine salvato con {n, plural, one {# riga} other {# righe}}', {'n': size(form.righe)}) }}"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "sezione-dialog",
      "type": "section",
      "title": "{{ t('vetrina_campi.dialog', 'Dialog con form') }}",
      "components": [
        {
          "id": "spiega-dialog",
          "type": "text",
          "text": "{{ t('vetrina_campi.dialog_spiega', 'Il passo dialog apre una finestra con un form. Se il salvataggio riesce la finestra si chiude e la sequenza prosegue (ricarica e messaggio); Annulla la ferma.') }}"
        },
        {
          "id": "btn-nuovo-contatto",
          "type": "button",
          "label": "{{ t('vetrina_campi.nuovo_contatto', 'Nuovo contatto') }}",
          "onClick": [
            {
              "dialog": {
                "title": "{{ t('vetrina_campi.nuovo_contatto', 'Nuovo contatto') }}",
                "fields": [
                  {
                    "name": "nome",
                    "type": "text",
                    "label": "{{ t('vetrina_campi.nome_cognome', 'Nome e cognome') }}",
                    "required": true
                  },
                  {
                    "name": "email",
                    "type": "text",
                    "label": "{{ t('vetrina_campi.email', 'E-mail') }}",
                    "required": true,
                    "validate": {
                      "rule": "{{ value.contains('@') }}",
                      "message": "{{ t('vetrina_campi.email_non_valida', 'Indirizzo e-mail non valido') }}"
                    }
                  },
                  {
                    "name": "ruolo",
                    "type": "radio",
                    "label": "{{ t('vetrina_campi.ruolo', 'Ruolo') }}",
                    "options": [
                      "acquisti",
                      "amministrazione",
                      "tecnico"
                    ],
                    "optionKey": "valori.ruolo"
                  }
                ],
                "initial": {
                  "ruolo": "acquisti"
                },
                "submitLabel": "{{ t('comune.salva', 'Salva') }}",
                "onSubmit": [
                  {
                    "call": "creaContatto"
                  }
                ]
              }
            },
            {
              "refresh": "contatti"
            },
            {
              "toast": "{{ t('vetrina_campi.contatto_creato', 'Contatto creato') }}"
            }
          ]
        },
        {
          "id": "tabella-contatti",
          "type": "table",
          "source": "contatti",
          "columns": [
            {
              "field": "nome",
              "label": "{{ t('vetrina_campi.nome_cognome', 'Nome e cognome') }}"
            },
            {
              "field": "email",
              "label": "{{ t('vetrina_campi.email', 'E-mail') }}"
            },
            {
              "field": "ruolo",
              "label": "{{ t('vetrina_campi.ruolo', 'Ruolo') }}",
              "valueKey": "valori.ruolo"
            }
          ],
          "rowActions": [
            {
              "id": "btn-modifica-contatto",
              "label": "{{ t('vetrina_campi.modifica', 'Modifica') }}",
              "onClick": [
                {
                  "dialog": {
                    "title": "{{ t('vetrina_campi.modifica_contatto', 'Modifica {nome}', {'nome': row.nome}) }}",
                    "fields": [
                      {
                        "name": "nome",
                        "type": "text",
                        "label": "{{ t('vetrina_campi.nome_cognome', 'Nome e cognome') }}",
                        "required": true
                      },
                      {
                        "name": "email",
                        "type": "text",
                        "label": "{{ t('vetrina_campi.email', 'E-mail') }}",
                        "required": true,
                        "validate": {
                          "rule": "{{ value.contains('@') }}",
                          "message": "{{ t('vetrina_campi.email_non_valida', 'Indirizzo e-mail non valido') }}"
                        }
                      },
                      {
                        "name": "ruolo",
                        "type": "radio",
                        "label": "{{ t('vetrina_campi.ruolo', 'Ruolo') }}",
                        "options": [
                          "acquisti",
                          "amministrazione",
                          "tecnico"
                        ],
                        "optionKey": "valori.ruolo"
                      }
                    ],
                    "initial": {
                      "nome": "{{ row.nome }}",
                      "email": "{{ row.email }}",
                      "ruolo": "{{ row.ruolo }}"
                    },
                    "submitLabel": "{{ t('comune.salva', 'Salva') }}",
                    "onSubmit": [
                      {
                        "call": "modificaContatto",
                        "args": {
                          "id": "{{ row.id }}"
                        }
                      }
                    ]
                  }
                },
                {
                  "refresh": "contatti"
                },
                {
                  "toast": "{{ t('vetrina_campi.contatto_aggiornato', 'Contatto aggiornato') }}"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "sezione-filtri-nuovi",
      "type": "section",
      "title": "{{ t('vetrina_campi.filtri_nuovi', 'I nuovi tipi nella barra dei filtri') }}",
      "components": [
        {
          "id": "filtri-campi",
          "type": "filterBar",
          "bind": "state.filtriCampi",
          "fields": [
            {
              "name": "stati",
              "type": "multiselect",
              "label": "{{ t('comune.stato', 'Stato') }}",
              "options": [
                "bozza",
                "inviata",
                "pagata"
              ],
              "optionKey": "valori.stato"
            },
            {
              "name": "tipo",
              "type": "radio",
              "label": "{{ t('comune.tipo', 'Tipo') }}",
              "options": [
                "attiva",
                "passiva"
              ],
              "optionKey": "valori.tipo"
            },
            {
              "name": "cliente",
              "type": "lookup",
              "label": "{{ t('comune.cliente', 'Cliente') }}",
              "lookup": {
                "source": "clienti",
                "valueField": "nome",
                "labelField": "nome",
                "minChars": 0
              }
            }
          ]
        },
        {
          "id": "fatture-filtrate",
          "type": "table",
          "source": "fatture",
          "columns": [
            {
              "field": "numero",
              "label": "{{ t('comune.numero', 'Numero') }}"
            },
            {
              "field": "tipo",
              "label": "{{ t('comune.tipo', 'Tipo') }}",
              "valueKey": "valori.tipo"
            },
            {
              "field": "stato",
              "label": "{{ t('comune.stato', 'Stato') }}",
              "format": "badge",
              "badges": {
                "bozza": "neutral",
                "inviata": "primary",
                "pagata": "success"
              },
              "valueKey": "valori.stato"
            }
          ]
        }
      ]
    }
  ]
}
