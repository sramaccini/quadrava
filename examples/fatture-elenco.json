{
  "schemaVersion": "1.0",
  "screen": "fatture-elenco",
  "title": "{{ t('fatture.fatture', 'Fatture') }}",
  "description": "{{ t('fatture.elenco_delle_fatture_con_filtro', 'Elenco delle fatture con filtro per stato e invio delle bozze.') }}",
  "requires": "fatture.fattura.leggi",
  "dataSources": {
    "fatture": {
      "type": "rest",
      "method": "GET",
      "url": "/api/fatture",
      "paging": "server",
      "params": {
        "stato": "{{has(params.stato) ? params.stato : state.filtri.stato}}",
        "page": "{{state.page}}"
      }
    },
    "inviaFattura": {
      "type": "rest",
      "method": "POST",
      "url": "/api/fatture/{{id}}/invia"
    }
  },
  "components": [
    {
      "id": "filtri-fatture",
      "type": "filterBar",
      "bind": "state.filtri",
      "hiddenIf": "{{has(params.stato)}}",
      "fields": [
        {
          "name": "stato",
          "type": "select",
          "label": "{{ t('comune.stato', 'Stato') }}",
          "options": [
            "bozza",
            "inviata",
            "pagata"
          ],
          "optionKey": "valori.stato"
        }
      ]
    },
    {
      "id": "tabella-fatture",
      "type": "table",
      "source": "fatture",
      "columns": [
        {
          "field": "numero",
          "label": "{{ t('comune.numero', 'Numero') }}"
        },
        {
          "field": "cliente",
          "label": "{{ t('comune.cliente', 'Cliente') }}"
        },
        {
          "field": "importo",
          "label": "{{ t('comune.importo', 'Importo (€)') }}"
        },
        {
          "field": "stato",
          "label": "{{ t('comune.stato', 'Stato') }}",
          "valueKey": "valori.stato"
        }
      ],
      "rowActions": [
        {
          "id": "btn-invia",
          "label": "{{ t('fatture.invia', 'Invia') }}",
          "visibleIf": "{{can('fatture.fattura.crea') && row.stato == 'bozza'}}",
          "onClick": [
            {
              "call": "inviaFattura",
              "args": {
                "id": "{{row.id}}"
              },
              "onError": {
                "toast": "{{ t('fatture.invio_non_riuscito', 'Invio non riuscito') }}"
              }
            },
            {
              "refresh": "fatture"
            },
            {
              "toast": "{{ t('fatture.inviata', 'Fattura {n} inviata', {'n': row.numero}) }}"
            }
          ]
        }
      ]
    }
  ]
}
